  // Generate optimized image URLs for different sizes
  static String getImageUrl(String imageId, {ImageSize size = ImageSize.medium}) {
    final sizeSuffix = switch (size) {
      ImageSize.thumbnail => 'thumb',
      ImageSize.small => 'sm',
      ImageSize.medium => 'md',
      ImageSize.large => 'lg',
      ImageSize.original => 'orig',
    }
    
    return '$cdnBaseUrl/images/$imageId/$sizeSuffix';
  }
  
  // Upload media to CDN with progress tracking
  static Future<String> uploadMedia({
    required Uint8List data,
    required void Function(double progress)? onProgress,
  }) async {
    final optimizedData = await optimizeImage(data);
    
    final uri = Uri.parse('$cdnBaseUrl/upload');
    final request = http.MultipartRequest('POST', uri);
    
    final multipartFile = http.MultipartFile.fromBytes(
      'file',
      optimizedData,
      filename: 'image.jpg',
    );
    
    request.files.add(multipartFile);
    
    final response = await request.send();
    
    if (response.statusCode != 200) {
      throw Exception('Upload failed');
    }
    
    final responseData = await response.stream.toBytes();
    final jsonResponse = json.decode(String.fromCharCodes(responseData));
    
    return jsonResponse['id'] as String;
  }
}

enum ImageSize {
  thumbnail,  // 150x150
  small,      // 300x300
  medium,     // 600x600
  large,      // 1200x1200
  original    // Original size
}