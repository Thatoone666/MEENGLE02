# Production environment variables for Meengle app

# API Configuration
API_URL=https://api.meengle.com
SOCKET_URL=wss://api.meengle.com
CDN_URL=https://cdn.meengle.com

# Payment Configuration
STRIPE_PUBLISHABLE=pk_live_YOUR_KEY
PAYFAST_MERCHANT_ID=YOUR_MERCHANT_ID
PAYFAST_MERCHANT_KEY=YOUR_MERCHANT_KEY

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXX
ENABLE_ANALYTICS=true

# Feature Flags
ENABLE_CHAT_REACTIONS=true
ENABLE_VOICE_MESSAGES=true
ENABLE_VIDEO_CHAT=true
ENABLE_LOCATION_SHARING=true

# Performance
MAX_UPLOAD_SIZE_MB=10
CHAT_PAGE_SIZE=50
IMAGE_CACHE_SIZE_MB=100

# App Info
APP_VERSION=1.0.0
BUILD_NUMBER=1
ENVIRONMENT=production