# Meengle environment variables example
# Required
MONGO_URI=mongodb://user:pass@dbhost:27017/meengle
JWT_SECRET=your_jwt_secret

# Optional / production
SENTRY_DSN=
SENTRY_TRACES_RATE=0.05
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
STRIPE_SECRET=
GCS_BUCKET=
CORS_ORIGINS=http://localhost:3000

# Email configuration (for password reset, etc.)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Meengle Support <support@meengle.com>"

# Cloud Run / CI related
# For CI/CD you should set GCP_SA_KEY as GitHub secret (JSON) and GCP_PROJECT/GCP_REGION
GCP_PROJECT=
GCP_REGION=

# Android keystore (base64) and passwords - set as GitHub secrets for Android workflow
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
