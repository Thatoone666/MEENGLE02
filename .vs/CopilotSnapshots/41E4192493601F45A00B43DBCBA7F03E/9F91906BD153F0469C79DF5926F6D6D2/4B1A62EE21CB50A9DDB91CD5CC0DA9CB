import express from 'express';
import http from 'http';
import { Server } from 'socket.io';
import path from 'path';
import compression from 'compression';
import helmet from 'helmet';
import dotenv from 'dotenv';
import { fileURLToPath } from 'url';
import { authRouter } from './routes/auth.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// Load environment variables
dotenv.config({ path: path.resolve(__dirname, '.env') });

const app = express();

// Add security headers
app.use(helmet());

// Add compression middleware
app.use(compression());

// Basic middleware
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

// --- SOCKET.IO REAL-TIME CHAT SETUP ---
const server = http.createServer(app);
const io = new Server(server, {
    cors: {
        origin: process.env.NODE_ENV === 'production' 
            ? ['https://meengle.app', 'https://www.meengle.app']
            : process.env.CORS_ORIGIN || '*',
        credentials: true,
        methods: ['GET', 'POST']
    },
    transports: ['websocket', 'polling'],
    maxHttpBufferSize: 1e6,
    pingTimeout: 60000,
    pingInterval: 25000
});

// ════════════════════════════════════════════════════════════════
// IN-MEMORY ONLINE STATUS TRACKER
// ════════════════════════════════════════════════════════════════

const onlineUsers = new Map();
const userSockets = new Map();

// ════════════════════════════════════════════════════════════════
// SOCKET.IO EVENT HANDLERS
// ════════════════════════════════════════════════════════════════

io.on('connection', (socket) => {
    console.log(`[SOCKET] New connection: ${socket.id}`);

    // User comes online
    socket.on('user-online', (data) => {
        const { userId } = data;
        const now = new Date();
        
        onlineUsers.set(userId, {
            socketId: socket.id,
            connectedAt: now,
            lastActivity: now,
            status: 'online'
        });
        
        userSockets.set(socket.id, userId);
        
        io.emit('user-status-changed', {
            userId,
            status: 'online',
            timestamp: now
        });
        
        console.log(`[ONLINE] User ${userId} came online`);
    });

    // User activity
    socket.on('user-activity', () => {
        const userId = userSockets.get(socket.id);
        if (userId && onlineUsers.has(userId)) {
            const userData = onlineUsers.get(userId);
            userData.lastActivity = new Date();
            onlineUsers.set(userId, userData);
        }
    });

    // User typing
    socket.on('user-typing', (data) => {
        const { recipientId } = data;
        const userId = userSockets.get(socket.id);
        
        if (userId) {
            io.to(`user-${recipientId}`).emit('user-typing', {
                userId,
                timestamp: new Date()
            });
        }
    });

    // Stop typing
    socket.on('user-stop-typing', (data) => {
        const { recipientId } = data;
        const userId = userSockets.get(socket.id);
        
        if (userId) {
            io.to(`user-${recipientId}`).emit('user-stop-typing', {
                userId,
                timestamp: new Date()
            });
        }
    });

    // Join user room
    socket.on('join-room', (data) => {
        const { userId } = data;
        socket.join(`user-${userId}`);
    });

    // Disconnect
    socket.on('disconnect', () => {
        const userId = userSockets.get(socket.id);
        
        if (userId) {
            onlineUsers.delete(userId);
            io.emit('user-status-changed', {
                userId,
                status: 'offline',
                timestamp: new Date()
            });
            console.log(`[OFFLINE] User ${userId} disconnected`);
        }
        
        userSockets.delete(socket.id);
    });
});

// ════════════════════════════════════════════════════════════════
// ROUTES
// ════════════════════════════════════════════════════════════════

app.use('/api/auth', authRouter);

// ════════════════════════════════════════════════════════════════
// REST API ENDPOINTS
// ════════════════════════════════════════════════════════════════

// Health check
app.get('/health', (req, res) => {
    res.json({ 
        status: 'healthy',
        timestamp: new Date().toISOString(),
        uptime: process.uptime(),
        onlineUsers: onlineUsers.size
    });
});

// Test endpoint
app.get('/api/test', (req, res) => {
    res.json({ 
        message: 'Backend is working!',
        timestamp: new Date().toISOString()
    });
});

// Get single user status
app.get('/api/status/:userId', (req, res) => {
    const { userId } = req.params;
    const userData = onlineUsers.get(userId);
    
    if (userData) {
        res.json({
            userId,
            isOnline: true,
            status: userData.status,
            connectedAt: userData.connectedAt,
            lastActivity: userData.lastActivity
        });
    } else {
        res.json({
            userId,
            isOnline: false,
            status: 'offline',
            lastSeen: null
        });
    }
});

// Get multiple users status
app.post('/api/statuses', (req, res) => {
    const { userIds } = req.body;
    
    if (!Array.isArray(userIds)) {
        return res.status(400).json({ error: 'userIds must be an array' });
    }
    
    const statuses = {};
    userIds.forEach(userId => {
        const userData = onlineUsers.get(userId);
        statuses[userId] = userData ? 
            { isOnline: true, status: userData.status } :
            { isOnline: false, status: 'offline' };
    });
    
    res.json({ statuses });
});

// Get online count
app.get('/api/online-count', (req, res) => {
    res.json({ onlineCount: onlineUsers.size });
});

// Get all online users
app.get('/api/online-users', (req, res) => {
    const users = Array.from(onlineUsers.entries()).map(([userId, data]) => ({
        userId,
        status: data.status,
        connectedAt: data.connectedAt,
        lastActivity: data.lastActivity
    }));
    
    res.json({ onlineUsers: users });
});

// 404 handler
app.use((req, res) => {
    res.status(404).json({ error: 'Endpoint not found' });
});

const PORT = process.env.PORT || 3001;

const runningServer = server.listen(PORT, () => {
    console.log(`\n${'═'.repeat(60)}`);
    console.log('🚀 MEENGLE SERVER STARTED');
    console.log('═'.repeat(60));
    console.log(`📍 Port: ${PORT}`);
    console.log(`🌍 Environment: ${process.env.NODE_ENV || 'development'}`);
    console.log(`⏰ Started: ${new Date().toISOString()}`);
    console.log('═'.repeat(60));
    console.log('\n✅ Server ready to accept connections\n');
    console.log('Available endpoints:');
    console.log('  POST   /api/auth/signup');
    console.log('  POST   /api/auth/login');
    console.log('  GET    /api/auth/me (requires token)');
    console.log('  POST   /api/auth/profile (requires token)');
    console.log('  GET    /health');
    console.log('  GET    /api/test\n');
});

// Graceful shutdown
process.on('SIGTERM', () => {
    console.log('SIGTERM received: Closing server gracefully...');
    runningServer.close(() => {
        console.log('Server closed');
        process.exit(0);
    });
});

process.on('SIGINT', () => {
    console.log('SIGINT received: Closing server gracefully...');
    runningServer.close(() => {
        console.log('Server closed');
        process.exit(0);
    });
});

process.on('unhandledRejection', (reason) => {
    console.error('❌ Unhandled Rejection:', reason);
});

export { app, server, io };
