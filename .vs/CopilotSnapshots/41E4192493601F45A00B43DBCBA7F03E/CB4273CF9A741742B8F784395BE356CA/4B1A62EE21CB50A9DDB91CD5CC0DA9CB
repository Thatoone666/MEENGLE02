import express from 'express';
import http from 'http';
import { Server } from 'socket.io';
import path from 'path';
import compression from 'compression';
import helmet from 'helmet';
import dotenv from 'dotenv';
import { fileURLToPath } from 'url';
import onlineStatusService from './services/online_status_service.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// Load environment variables
dotenv.config({ path: path.resolve(__dirname, '.env') });

// ════════════════════════════════════════════════════════════════
// INITIALIZE APPLICATION
// ════════════════════════════════════════════════════════════════

const app = express();

// Add security headers
app.use(helmet());

// Add compression middleware
app.use(compression());

// Basic middleware
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

// --- SOCKET.IO REAL-TIME CHAT SETUP ---
const server = http.createServer(app);
const io = new Server(server, {
    cors: {
        origin: process.env.NODE_ENV === 'production' 
            ? ['https://meengle.app', 'https://www.meengle.app']
            : process.env.CORS_ORIGIN || '*',
        credentials: true,
        methods: ['GET', 'POST']
    },
    transports: ['websocket', 'polling'],
    maxHttpBufferSize: 1e6,
    pingTimeout: 60000,
    pingInterval: 25000
});

// ════════════════════════════════════════════════════════════════
// SOCKET.IO EVENT HANDLERS
// ════════════════════════════════════════════════════════════════

io.on('connection', (socket) => {
    console.log(`[SOCKET] New connection: ${socket.id}`);

    // User comes online
    socket.on('user-online', (data) => {
        const { userId, userData } = data;
        
        onlineStatusService.userConnected(userId, socket.id, userData);
        
        // Notify all connected clients
        io.emit('user-status-changed', {
            userId,
            status: 'online',
            timestamp: new Date()
        });
        
        console.log(`[ONLINE] User ${userId} came online`);
    });

    // User activity (prevents idle)
    socket.on('user-activity', (data) => {
        onlineStatusService.updateActivity(socket.id);
    });

    // User typing in chat
    socket.on('user-typing', (data) => {
        const { recipientId } = data;
        const userId = Array.from(onlineStatusService.onlineUsers.entries())
            .find(([_, userData]) => userData.socketId === socket.id)?.[0];
        
        if (userId) {
            io.to(`user-${recipientId}`).emit('user-typing', {
                userId,
                timestamp: new Date()
            });
        }
    });

    // Stop typing
    socket.on('user-stop-typing', (data) => {
        const { recipientId } = data;
        const userId = Array.from(onlineStatusService.onlineUsers.entries())
            .find(([_, userData]) => userData.socketId === socket.id)?.[0];
        
        if (userId) {
            io.to(`user-${recipientId}`).emit('user-stop-typing', {
                userId,
                timestamp: new Date()
            });
        }
    });

    // Request online status for multiple users
    socket.on('request-statuses', (data) => {
        const { userIds } = data;
        const statuses = onlineStatusService.getStatusMultiple(userIds);
        
        socket.emit('statuses-response', {
            statuses,
            timestamp: new Date()
        });
    });

    // Join user room (for direct messages)
    socket.on('join-room', (data) => {
        const { userId } = data;
        socket.join(`user-${userId}`);
    });

    // Disconnect
    socket.on('disconnect', () => {
        onlineStatusService.userDisconnected(socket.id);
        
        io.emit('user-status-changed', {
            status: 'offline',
            timestamp: new Date()
        });
        
        console.log(`[OFFLINE] Connection ${socket.id} disconnected`);
    });
});

// ════════════════════════════════════════════════════════════════
// REST API ENDPOINTS
// ════════════════════════════════════════════════════════════════

// Get user online status
app.get('/api/status/:userId', (req, res) => {
    const { userId } = req.params;
    const status = onlineStatusService.getStatus(userId);
    
    res.json({
        userId,
        ...status,
        timestamp: new Date()
    });
});

// Get statuses for multiple users
app.post('/api/statuses', (req, res) => {
    const { userIds } = req.body;
    
    if (!Array.isArray(userIds)) {
        return res.status(400).json({ error: 'userIds must be an array' });
    }
    
    const statuses = onlineStatusService.getStatusMultiple(userIds);
    
    res.json({
        statuses,
        timestamp: new Date()
    });
});

// Get all online users count
app.get('/api/online-count', (req, res) => {
    res.json({
        onlineCount: onlineStatusService.getOnlineCount(),
        timestamp: new Date()
    });
});

// Get all online users list
app.get('/api/online-users', (req, res) => {
    res.json({
        onlineUsers: onlineStatusService.getOnlineUsers(),
        timestamp: new Date()
    });
});

// Health check endpoint
app.get('/health', (req, res) => {
    res.json({ 
        status: 'healthy',
        timestamp: new Date().toISOString(),
        uptime: process.uptime(),
        environment: process.env.NODE_ENV || 'development',
        mongoUri: process.env.MONGO_URI ? 'configured' : 'not configured',
        onlineUsers: onlineStatusService.getOnlineCount()
    });
});

// Test API endpoint
app.get('/api/test', (req, res) => {
    res.json({ 
        message: 'Backend is working!',
        timestamp: new Date().toISOString()
    });
});

// 404 handler
app.use((req, res) => {
    res.status(404).json({ error: 'Endpoint not found' });
});

const PORT = process.env.PORT || 3001;

// ════════════════════════════════════════════════════════════════
// START SERVER
// ════════════════════════════════════════════════════════════════

const runningServer = server.listen(PORT, () => {
    console.log(`\n${'═'.repeat(60)}`);
    console.log('🚀 MEENGLE SERVER STARTED');
    console.log('═'.repeat(60));
    console.log(`📍 Port: ${PORT}`);
    console.log(`🌍 Environment: ${process.env.NODE_ENV || 'development'}`);
    console.log(`📦 Version: 1.0.0`);
    console.log(`⏰ Started: ${new Date().toISOString()}`);
    console.log('═'.repeat(60));
    console.log('\n✅ Server ready to accept connections\n');
    console.log(`📊 Health Check: http://localhost:${PORT}/health`);
    console.log(`📊 Test Endpoint: http://localhost:${PORT}/api/test`);
    console.log(`📊 Online Users: http://localhost:${PORT}/api/online-users\n`);
});

// Graceful shutdown
process.on('SIGTERM', () => {
    console.log('SIGTERM received: Closing server gracefully...');
    runningServer.close(() => {
        console.log('Server closed');
        process.exit(0);
    });
});

process.on('SIGINT', () => {
    console.log('SIGINT received: Closing server gracefully...');
    runningServer.close(() => {
        console.log('Server closed');
        process.exit(0);
    });
});

// Unhandled rejection handler
process.on('unhandledRejection', (reason, promise) => {
    console.error('❌ Unhandled Rejection:', reason);
});

export { app, server, io };
