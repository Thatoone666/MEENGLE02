const express = require('express');
const router = express.Router();
const auth = require('../middleware/auth');
const OnTheFly = require('../models/OnTheFly');
const User = require('../models/User');

// @route   POST api/onthefly
// @desc    Create an "On the Fly" post
// @access  Private
router.post('/', auth, async (req, res) => {
    try {
        const { activity, location } = req.body;

        if (!activity) {
            return res.status(400).json({ msg: 'Activity is required' });
        }

        const newPost = new OnTheFly({
            userId: req.user.id,
            activity,
            location
        });

        const post = await newPost.save();
        res.json(post);
    } catch (err) {
        err.status = 500;
        err.message = err.message || 'Server Error';
        next(err);
    }
});

// @route   GET api/onthefly
// @desc    Get all "On the Fly" posts
// @access  Private
router.get('/', auth, async (req, res) => {
    try {
        // Find posts and populate user data, selecting only specific fields
        const posts = await OnTheFly.find()
            .populate('userId', ['username', 'profile.age', 'profile.photos'])
            .sort({ createdAt: -1 });
            
        res.json(posts);
    } catch (err) {
        err.status = 500;
        err.message = err.message || 'Server Error';
        next(err);
    }
});

module.exports = router;
