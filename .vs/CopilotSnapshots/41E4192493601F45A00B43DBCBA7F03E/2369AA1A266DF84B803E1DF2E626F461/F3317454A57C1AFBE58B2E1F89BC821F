/// Premium tier system for Meengle
/// Unique naming: Free ? Spark, Spark+ ? Flame, Flame+ ? Wildfire
/// Premium tiers with distinct pricing and features

enum MeengleTier {
  free,      // Free tier
  spark,     // First paid tier
  flame,     // Mid tier
  wildfire,  // Premium tier
}

enum BillingCycle {
  weekly,    // 1 week subscription
  monthly,   // 1 month subscription
  annual,    // 12 month subscription (best value)
}

class TierInfo {
  final MeengleTier tier;
  final String displayName;
  final String subtitle;
  final String description;
  final double weeklyPrice;   // 1 week
  final double monthlyPrice;  // 1 month (2x weekly)
  final double yearlyPrice;   // 1 year (17% discount)
  final Color primaryColor;
  final Color accentColor;
  final String icon;
  final List<String> features;
  final List<String> premiumFeatures;
  final bool isPopular;

  const TierInfo({
    required this.tier,
    required this.displayName,
    required this.subtitle,
    required this.description,
    required this.weeklyPrice,
    required this.monthlyPrice,
    required this.yearlyPrice,
    required this.primaryColor,
    required this.accentColor,
    required this.icon,
    required this.features,
    required this.premiumFeatures,
    this.isPopular = false,
  });

  // Calculate savings for monthly vs weekly
  double get monthlySavingsPercent {
    final weeklyTotal = weeklyPrice * 4.3; // Average weeks per month
    final savings = weeklyTotal - monthlyPrice;
    return (savings / weeklyTotal) * 100;
  }

  // Calculate yearly savings percentage
  double get yearlySavingsPercent {
    final monthlyTotal = monthlyPrice * 12;
    final savings = monthlyTotal - yearlyPrice;
    return (savings / monthlyTotal) * 100;
  }

  // Get price for any billing cycle
  double getPrice(BillingCycle cycle) {
    switch (cycle) {
      case BillingCycle.weekly:
        return weeklyPrice;
      case BillingCycle.monthly:
        return monthlyPrice;
      case BillingCycle.annual:
        return yearlyPrice;
    }
  }

  // Get display price per day for any cycle
  double getPricePerDay(BillingCycle cycle) {
    switch (cycle) {
      case BillingCycle.weekly:
        return weeklyPrice / 7;
      case BillingCycle.monthly:
        return monthlyPrice / 30;
      case BillingCycle.annual:
        return yearlyPrice / 365;
    }
  }

  // Get billing period text
  String getBillingPeriodText(BillingCycle cycle) {
    switch (cycle) {
      case BillingCycle.weekly:
        return '/week';
      case BillingCycle.monthly:
        return '/month';
      case BillingCycle.annual:
        return '/year';
    }
  }
}

