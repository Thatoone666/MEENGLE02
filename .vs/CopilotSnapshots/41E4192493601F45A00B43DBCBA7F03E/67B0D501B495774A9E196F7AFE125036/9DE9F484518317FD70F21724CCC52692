/// @route   GET /api/emergency/history/:userId
/// @desc    Get emergency share history
/// @access  Private
router.get('/history/:userId', authenticateToken, async (req, res) => {
  try {
    const history = await EmergencyLog.find({
      userId: req.params.userId,
    }).sort({ sharedAt: -1 }).limit(50);

    res.json({
      success: true,
      history,
    });
  } catch (err) {
    res.status(500).json({
      success: false,
      message: 'Error fetching history',
      error: err.message,
    });
  }
});

// Helper function: Send location email
async function sendLocationEmail(email, phone, location, serviceType) {
  try {
    const transporter = nodemailer.createTransport({
      service: 'gmail',
      auth: {
        user: process.env.EMAIL_USER,
        pass: process.env.EMAIL_PASSWORD,
      },
    });

    const mapUrl = `https://maps.google.com/?q=${location.latitude},${location.longitude}`;

    const mailOptions = {
      from: process.env.EMAIL_USER,
      to: email,
      subject: '?? Emergency Safety Alert - Location Shared',
      html: `
        <h2>Emergency Safety Alert</h2>
        <p>Someone has shared their location with you for safety purposes.</p>
        <p><strong>Location:</strong> ${location.address || `${location.latitude}, ${location.longitude}`}</p>
        <p><strong>Accuracy:</strong> ±${Math.round(location.accuracy)} meters</p>
        <p><strong>Time:</strong> ${new Date(location.timestamp).toLocaleString()}</p>
        <p><a href="${mapUrl}" style="background-color: #FF6B9A; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">View on Map</a></p>
        <p>Contact them immediately if needed: ${phone}</p>
        <p style="color: #666; font-size: 12px;">This location sharing was initiated through the Meengle Safety Feature.</p>
      `,
    };

    await transporter.sendMail(mailOptions);
  } catch (err) {
    console.error('Error sending email:', err);
  }
}

