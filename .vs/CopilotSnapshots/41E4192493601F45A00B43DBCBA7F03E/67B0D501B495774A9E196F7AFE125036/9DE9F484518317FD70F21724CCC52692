const express = require('express');
const router = express.Router();
const EmergencyContact = require('../models/EmergencyContact');
const EmergencyLog = require('../models/EmergencyLog');
const { authenticateToken } = require('../middleware/auth');
const nodemailer = require('nodemailer');

/// @route   GET /api/emergency/contacts/:userId
/// @desc    Get emergency contacts for a user
/// @access  Private
router.get('/contacts/:userId', authenticateToken, async (req, res) => {
  try {
    const contacts = await EmergencyContact.find({
      userId: req.params.userId,
    });

    res.json({
      success: true,
      contacts,
    });
  } catch (err) {
    res.status(500).json({
      success: false,
      message: 'Error fetching contacts',
      error: err.message,
    });
  }
});

/// @route   POST /api/emergency/contacts
/// @desc    Add new emergency contact
/// @access  Private
router.post('/contacts', authenticateToken, async (req, res) => {
  try {
    const { userId, name, phoneNumber, email, isFavourite } = req.body;

    const newContact = new EmergencyContact({
      userId,
      name,
      phoneNumber,
      email,
      isFavourite,
      addedAt: new Date(),
    });

    const contact = await newContact.save();

    res.status(201).json({
      success: true,
      contact,
    });
  } catch (err) {
    res.status(500).json({
      success: false,
      message: 'Error adding contact',
      error: err.message,
    });
  }
});

/// @route   PUT /api/emergency/contacts/:contactId/favourite
/// @desc    Toggle favourite status
/// @access  Private
router.put('/contacts/:contactId/favourite', authenticateToken, async (req, res) => {
  try {
    const contact = await EmergencyContact.findById(req.params.contactId);
    if (!contact) {
      return res.status(404).json({ success: false, message: 'Contact not found' });
    }

    contact.isFavourite = !contact.isFavourite;
    const updated = await contact.save();

    res.json({
      success: true,
      contact: updated,
    });
  } catch (err) {
    res.status(500).json({
      success: false,
      message: 'Error updating contact',
      error: err.message,
    });
  }
});

/// @route   DELETE /api/emergency/contacts/:contactId
/// @desc    Delete emergency contact
/// @access  Private
router.delete('/contacts/:contactId', authenticateToken, async (req, res) => {
  try {
    await EmergencyContact.findByIdAndDelete(req.params.contactId);

    res.json({
      success: true,
      message: 'Contact deleted',
    });
  } catch (err) {
    res.status(500).json({
      success: false,
      message: 'Error deleting contact',
      error: err.message,
    });
  }
});

/// @route   POST /api/emergency/share-location
/// @desc    Share location with emergency contact
/// @access  Private
router.post('/share-location', authenticateToken, async (req, res) => {
  try {
    const {
      userId,
      contactId,
      contactEmail,
      contactPhone,
      location,
      serviceType,
      timestamp,
    } = req.body;

    // Log the share
    const log = new EmergencyLog({
      userId,
      contactId,
      location,
      serviceType,
      sharedAt: new Date(timestamp),
      acknowledged: false,
    });

    await log.save();

    // Send notification email
    await sendLocationEmail(
      contactEmail,
      contactPhone,
      location,
      serviceType,
    );

    // Could also send SMS, push notification, etc.

    res.json({
      success: true,
      message: 'Location shared successfully',
      log,
    });
  } catch (err) {
    res.status(500).json({
      success: false,
      message: 'Error sharing location',
      error: err.message,
    });
  }
});

