// ===== HELPER FUNCTIONS =====
function getPriceIdForTier(tierId, billingCycle) {
  const priceMap = {
    'spark-monthly': process.env.STRIPE_SPARK_MONTHLY,
    'spark-annual': process.env.STRIPE_SPARK_ANNUAL,
    'flame-monthly': process.env.STRIPE_FLAME_MONTHLY,
    'flame-annual': process.env.STRIPE_FLAME_ANNUAL,
    'wildfire-monthly': process.env.STRIPE_WILDFIRE_MONTHLY,
    'wildfire-annual': process.env.STRIPE_WILDFIRE_ANNUAL,
  };

  return priceMap[`${tierId}-${billingCycle}`];
}

