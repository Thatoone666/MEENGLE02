router.get('/verify/:transactionId', async (req, res) => {
  try {
    const { method } = req.query;
    const { transactionId } = req.params;

    let status;
    switch (method) {
      case 'stripe':
        status = await paymentMethods.stripe.verifyPayment(transactionId);
        break;
      case 'yoco':
        status = await paymentMethods.yoco.verifyPayment(transactionId);
        break;
      case 'ozow':
        status = await paymentMethods.ozow.verifyPayment(transactionId);
        break;
      case 'snapscan':
        status = await paymentMethods.snapscan.verifyPayment(transactionId);
        break;
      case 'luno':
        status = await paymentMethods.luno.verifyPayment(transactionId);
        break;
      default:
        return res.status(400).json({ error: 'Invalid payment method' });
    }

    res.json(status);
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

// ===== WEBHOOK HANDLERS =====
router.post('/webhook/stripe', express.raw({ type: 'application/json' }), async (req, res) => {
  try {
    const sig = req.headers['stripe-signature'];
    const event = stripe.webhooks.constructEvent(
      req.body,
      sig,
      process.env.STRIPE_WEBHOOK_SECRET
    );

    switch (event.type) {
      case 'payment_intent.succeeded':
        await handlePaymentSuccess(event.data.object);
        break;
      case 'payment_intent.payment_failed':
        await handlePaymentFailed(event.data.object);
        break;
      case 'customer.subscription.created':
        await handleSubscriptionCreated(event.data.object);
        break;
      case 'customer.subscription.deleted':
        await handleSubscriptionCancelled(event.data.object);
        break;
    }

    res.json({ received: true });
  } catch (error) {
    console.error('Webhook error:', error);
    res.status(400).send(`Webhook Error: ${error.message}`);
  }
});

router.post('/webhook/ozow', async (req, res) => {
