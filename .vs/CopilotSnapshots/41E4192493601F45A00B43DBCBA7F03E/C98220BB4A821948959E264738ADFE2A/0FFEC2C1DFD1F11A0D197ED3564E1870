// ===== STRIPE ROUTES =====
router.post('/stripe/intent', authenticateToken, async (req, res) => {
  try {
    const { amount, currency, tierId } = req.body;

    const intent = await stripe.paymentIntents.create({
      amount,
      currency,
      metadata: {
        tierId,
        userId: req.user.id,
      },
    });

    res.json({
      clientSecret: intent.client_secret,
      id: intent.id,
    });
  } catch (error) {
    res.status(400).json({ error: error.message });
  }
});

router.post('/stripe/subscribe', authenticateToken, async (req, res) => {
  try {
    const { tierId, billingCycle, amount } = req.body;
    const priceId = getPriceIdForTier(tierId, billingCycle);

    const subscription = await stripe.subscriptions.create({
      customer: req.user.stripeCustomerId,
      items: [{ price: priceId }],
      metadata: {
        tierId,
        userId: req.user.id,
      },
    });

    res.json({
      subscriptionId: subscription.id,
      status: subscription.status,
    });
  } catch (error) {
    res.status(400).json({ error: error.message });
  }
});

router.post('/stripe/customer', authenticateToken, async (req, res) => {
  try {
    const { email, userId } = req.body;

    const customer = await stripe.customers.create({
      email,
