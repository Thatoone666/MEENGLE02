import 'package:http/http.dart' as http;
import 'dart:convert';

class APIService {
  static const String baseURL = 'http://localhost:3001/api';
  static String? _token;
  static String? _userId;

  static void setAuth(String token, String userId) {
    _token = token;
    _userId = userId;
  }

  static Map<String, String> get _headers => {
    'Content-Type': 'application/json',
    if (_token != null) 'Authorization': 'Bearer $_token',
  };

  // Auth
  static Future<Map<String, dynamic>> signup(String email, String password, String name) async {
    try {
      final response = await http.post(
        Uri.parse('$baseURL/auth/signup'),
        headers: _headers,
        body: jsonEncode({
          'email': email,
          'password': password,
          'name': name,
        }),
      );

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        setAuth(data['token'], data['user']['id']);
        return data;
      }
      throw Exception(jsonDecode(response.body)['error'] ?? 'Signup failed');
    } catch (e) {
      throw Exception('Signup error: $e');
    }
  }

  static Future<Map<String, dynamic>> login(String email, String password) async {
    try {
      final response = await http.post(
        Uri.parse('$baseURL/auth/login'),
        headers: _headers,
        body: jsonEncode({
          'email': email,
          'password': password,
        }),
      );

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        setAuth(data['token'], data['user']['id']);
        return data;
      }
      throw Exception(jsonDecode(response.body)['error'] ?? 'Login failed');
    } catch (e) {
      throw Exception('Login error: $e');
    }
  }

  static Future<Map<String, dynamic>> updateProfile({
    required String age,
    required String bio,
    required String gender,
    List<String>? photos,
  }) async {
    try {
      final response = await http.post(
        Uri.parse('$baseURL/auth/profile'),
        headers: _headers,
        body: jsonEncode({
          'age': int.tryParse(age) ?? 0,
          'bio': bio,
          'gender': gender,
          'photos': photos ?? [],
        }),
      );

      if (response.statusCode == 200) {
        return jsonDecode(response.body);
      }
      throw Exception('Profile update failed');
    } catch (e) {
      throw Exception('Profile error: $e');
    }
  }

  // Matching
  static Future<List<Map<String, dynamic>>> getPotentialMatches() async {
    try {
      final response = await http.get(
        Uri.parse('$baseURL/matches/potential?userId=$_userId'),
        headers: _headers,
      );

      if (response.statusCode == 200) {
        final List data = jsonDecode(response.body);
        return data.cast<Map<String, dynamic>>();
      }
      return [];
    } catch (e) {
      print('Error getting matches: $e');
      return [];
    }
  }

  static Future<bool> likeUser(String targetUserId) async {
    try {
      final response = await http.post(
        Uri.parse('$baseURL/matches/like'),
        headers: _headers,
        body: jsonEncode({
          'userId': _userId,
          'targetUserId': targetUserId,
        }),
      );

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        return data['mutualMatch'] ?? false;
      }
      return false;
    } catch (e) {
      print('Like error: $e');
      return false;
    }
  }

  static Future<bool> passUser(String targetUserId) async {
    try {
      final response = await http.post(
        Uri.parse('$baseURL/matches/pass'),
        headers: _headers,
        body: jsonEncode({
          'userId': _userId,
          'targetUserId': targetUserId,
        }),
      );

      return response.statusCode == 200;
    } catch (e) {
      print('Pass error: $e');
      return false;
    }
  }

  static Future<List<Map<String, dynamic>>> getMatches() async {
    try {
      final response = await http.get(
        Uri.parse('$baseURL/matches/matches/$_userId'),
        headers: _headers,
      );

      if (response.statusCode == 200) {
        final List data = jsonDecode(response.body);
        return data.cast<Map<String, dynamic>>();
      }
      return [];
    } catch (e) {
      print('Error getting matches: $e');
      return [];
    }
  }

  // Utility
  static String? resolveAssetUrl(String url) {
    if (url.startsWith('http')) return url;
    return '$baseURL/media/$url';
  }
}
