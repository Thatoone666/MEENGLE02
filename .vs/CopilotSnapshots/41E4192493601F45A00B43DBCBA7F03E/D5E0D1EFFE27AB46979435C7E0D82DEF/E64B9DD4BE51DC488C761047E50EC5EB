const express = require('express');
const router = express.Router();
const auth = require('../middleware/auth');
const { Note } = require('../models/featureModels');

// Get notes for a user (received notes on their profile)
router.get('/:userId', auth, async (req, res) => {
  try {
    const { userId } = req.params;
    const notes = await Note.find({ toUserId: userId })
      .sort({ createdAt: -1 });

    res.json({ success: true, notes });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// Post a new note
router.post('/', auth, async (req, res) => {
  try {
    const { targetUserId, content, type } = req.body;

    if (!targetUserId || !content) {
      return res.status(400).json({ success: false, error: 'targetUserId and content required' });
    }

    if (content.length > 280) {
      return res.status(400).json({ success: false, error: 'Content exceeds 280 characters' });
    }

    const note = new Note({
      id: `note_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
      fromUserId: req.user.id,
      toUserId: targetUserId,
      content,
      type: type || 'comment',
      isAnonymous: true,
    });

    await note.save();
    res.status(201).json({ success: true, note });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// Like a note
router.post('/:id/like', auth, async (req, res) => {
  try {
    const { id } = req.params;

    const note = await Note.findOne({ id });
    if (!note) {
      return res.status(404).json({ success: false, error: 'Note not found' });
    }

    if (!note.likedBy.includes(req.user.id)) {
      note.likedBy.push(req.user.id);
      note.likes += 1;
      await note.save();
    }

    res.json({ success: true, note });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// Reply to a note
router.post('/:id/reply', auth, async (req, res) => {
  try {
    const { id } = req.params;
    const { content } = req.body;

    if (!content || content.length > 280) {
      return res.status(400).json({ success: false, error: 'Invalid content' });
    }

    const originalNote = await Note.findOne({ id });
    if (!originalNote) {
      return res.status(404).json({ success: false, error: 'Note not found' });
    }

    const reply = new Note({
      id: `note_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
      fromUserId: req.user.id,
      toUserId: originalNote.fromUserId,
      content,
      type: 'comment',
      isAnonymous: true,
    });

    await reply.save();
    originalNote.replies.push(reply.id);
    await originalNote.save();

    res.status(201).json({ success: true, reply });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// Delete a note
router.delete('/:id', auth, async (req, res) => {
  try {
    const { id } = req.params;

    const note = await Note.findOne({ id });
    if (!note) {
      return res.status(404).json({ success: false, error: 'Note not found' });
    }

    if (note.toUserId !== req.user.id && note.fromUserId !== req.user.id) {
      return res.status(403).json({ success: false, error: 'Not authorized to delete this note' });
    }

    await Note.deleteOne({ id });
    res.json({ success: true, message: 'Note deleted' });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

module.exports = router;
