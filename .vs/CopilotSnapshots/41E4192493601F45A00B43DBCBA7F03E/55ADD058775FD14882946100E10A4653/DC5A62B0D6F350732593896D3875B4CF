router.post('/match', auth, async (req, res) => {
  try {
    const { toUserId, action } = req.body;
    
    if (!toUserId || !['like', 'pass'].includes(action)) {
      return res.status(400).json({ success: false, error: 'Invalid input' });
    }
    
    // Check if match already exists
    const existingMatch = await Match.findOne({
      $or: [
        { user1Id: req.user.id, user2Id: toUserId },
        { user1Id: toUserId, user2Id: req.user.id }
      ]
    });
    
    if (existingMatch) {
      return res.status(400).json({ success: false, error: 'Already matched with this user' });
    }
    
    const match = new Match({
      user1Id: req.user.id,
      user2Id: toUserId,
      action,
      isVerified: action === 'like',
      matchedAt: action === 'like' ? new Date() : null,
      createdAt: new Date()
    });
    
    await match.save();
    res.json({ success: true, match });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

router.get('/conversations', auth, async (req, res) => {
  try {
    // Find mutual matches (both users liked each other)
    const mutualMatches = await Match.find({
      $or: [
        { user1Id: req.user.id, action: 'like' },
        { user2Id: req.user.id, action: 'like' }
      ]
    }).populate('user1Id user2Id', 'name profilePhoto');
    
    // Filter for mutual likes
    const conversations = [];
    const userMatches = new Set();
    
    for (const m of mutualMatches) {
      const otherId = m.user1Id === req.user.id ? m.user2Id : m.user1Id;
      if (userMatches.has(otherId)) {
        conversations.push(m);
      } else {
        userMatches.add(otherId);
      }
    }
    
    res.json({ success: true, conversations });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

router.get('/likes', auth, async (req, res) => {
  try {
    const likes = await Match.countDocuments({
      user2Id: req.user.id,
      action: 'like'
    });
    
    res.json({ success: true, likeCount: likes });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

router.post('/unmatch/:userId', auth, async (req, res) => {
  try {
    const result = await Match.deleteOne({
      $or: [
        { user1Id: req.user.id, user2Id: req.params.userId },
        { user1Id: req.params.userId, user2Id: req.user.id }
      ]
    });
    
    if (result.deletedCount === 0) {
      return res.status(404).json({ success: false, error: 'Match not found' });
    }
    
    res.json({ success: true });
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

