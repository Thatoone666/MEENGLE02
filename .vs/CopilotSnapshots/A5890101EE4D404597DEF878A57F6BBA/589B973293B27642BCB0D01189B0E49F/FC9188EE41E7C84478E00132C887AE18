name: meengle_flutter
description: A minimal starter port of Meengle to Flutter
publish_to: 'none'
version: 0.1.0

environment:
  sdk: ">=2.17.0 <4.0.0"

dependencies:
  flutter:
    sdk: flutter
  flutter_web_plugins:
    sdk: flutter
  image: ^4.1.3  # For image processing and compression
  crypto: ^3.0.3  # For payment signature generation
  http: ^1.5.0
  js: ^0.6.7  # For JavaScript interop in web
  shared_preferences: ^2.5.3
  provider: ^6.1.5+1
  socket_io_client: ^3.1.2
  image_picker: ^1.2.0
  webview_flutter: ^4.13.0
  intl: ^0.20.2
  flutter_stripe: ^12.0.2
  photo_view: ^0.15.0
  timeago: ^3.6.1
  geolocator: ^12.0.0
  google_maps_flutter: ^2.6.1
  flutter_card_swiper: ^7.0.2
  confetti: ^0.8.0
  cached_network_image: ^3.4.1
  flutter_bloc: ^8.1.3
  equatable: ^2.0.5
  google_fonts: ^6.1.0
  url_strategy: ^0.2.0
  universal_html: ^2.2.4
  flutter_adaptive_scaffold: ^0.1.7
  responsive_framework: ^1.1.1
  http_parser: ^4.1.2

dev_dependencies:
  flutter_test:
    sdk: flutter
  mockito: ^5.5.1
  flutter_lints: ^6.0.0
  build_runner: ^2.10.1

flutter:
  uses-material-design: true
