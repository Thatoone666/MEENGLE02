/// Subscription model for backend
class SubscriptionModel {
  final String userId;
  final MeengleTier tier;
  final DateTime startDate;
  final DateTime expiryDate;
  final bool isActive;
  final String paymentMethod;
  final bool autoRenew;
  final int renewalCount;

  SubscriptionModel({
    required this.userId,
    required this.tier,
    required this.startDate,
    required this.expiryDate,
    required this.isActive,
    required this.paymentMethod,
    required this.autoRenew,
    this.renewalCount = 0,
  });

  bool get isExpired => DateTime.now().isAfter(expiryDate);
  bool get expiresIn7Days =>
      expiryDate.difference(DateTime.now()).inDays <= 7 &&
      expiryDate.difference(DateTime.now()).inDays > 0;

  Map<String, dynamic> toJson() => {
    'userId': userId,
    'tier': tier.toString(),
    'startDate': startDate.toIso8601String(),
    'expiryDate': expiryDate.toIso8601String(),
    'isActive': isActive,
    'paymentMethod': paymentMethod,
    'autoRenew': autoRenew,
    'renewalCount': renewalCount,
  };

  factory SubscriptionModel.fromJson(Map<String, dynamic> json) {
    return SubscriptionModel(
      userId: json['userId'],
      tier: MeengleTier.values.firstWhere(
        (t) => t.toString() == json['tier'],
        orElse: () => MeengleTier.free,
      ),
      startDate: DateTime.parse(json['startDate']),
      expiryDate: DateTime.parse(json['expiryDate']),
      isActive: json['isActive'],
      paymentMethod: json['paymentMethod'],
      autoRenew: json['autoRenew'],
      renewalCount: json['renewalCount'] ?? 0,
    );
  }
}
