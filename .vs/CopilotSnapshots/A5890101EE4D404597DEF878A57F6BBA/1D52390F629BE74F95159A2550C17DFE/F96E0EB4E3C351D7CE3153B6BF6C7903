    final fromInfo = tiers[fromTier]!;
    final toInfo = tiers[toTier]!;

    final fromFeatures = {...fromInfo.features, ...fromInfo.premiumFeatures};
    final toFeatures = {...toInfo.features, ...toInfo.premiumFeatures};

    return toFeatures.difference(fromFeatures).toList();
  }
