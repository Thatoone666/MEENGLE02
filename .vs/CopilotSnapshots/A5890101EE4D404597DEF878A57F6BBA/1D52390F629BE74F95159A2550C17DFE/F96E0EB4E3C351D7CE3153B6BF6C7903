/// Premium tier system for Meengle
/// Unique naming: Free → Spark, Spark+ → Flame, Flame+ → Wildfire
/// Premium tiers with distinct pricing and features

enum MeengleTier {
  free,      // Free tier
  spark,     // First paid tier ($4.99/month)
  flame,     // Mid tier ($9.99/month)
  wildfire,  // Premium tier ($19.99/month)
}

class TierInfo {
  final MeengleTier tier;
  final String displayName;
  final String subtitle;
  final String description;
  final double monthlyPrice;  // USD
  final double yearlyPrice;   // USD
  final Color primaryColor;
  final Color accentColor;
  final String icon;
  final List<String> features;
  final List<String> premiumFeatures;
  final bool isPopular;

  const TierInfo({
    required this.tier,
    required this.displayName,
    required this.subtitle,
    required this.description,
    required this.monthlyPrice,
    required this.yearlyPrice,
    required this.primaryColor,
    required this.accentColor,
    required this.icon,
    required this.features,
    required this.premiumFeatures,
    this.isPopular = false,
  });

  // Calculate yearly savings percentage
  double get yearlySavingsPercent {
    final monthlyTotal = monthlyPrice * 12;
    final savings = monthlyTotal - yearlyPrice;
    return (savings / monthlyTotal) * 100;
  }

  // Yearly cost per month
  double get yearlyPerMonth => yearlyPrice / 12;
}

