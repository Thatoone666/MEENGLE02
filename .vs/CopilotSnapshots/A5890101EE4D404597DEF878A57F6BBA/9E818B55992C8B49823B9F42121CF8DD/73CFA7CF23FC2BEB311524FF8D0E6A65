import 'dart:ui';
import 'package:flutter/material.dart';
import 'package:flutter_card_swiper/flutter_card_swiper.dart';
import 'package:cached_network_image/cached_network_image.dart';
import 'package:meengle_flutter/services/api.dart';
import 'package:meengle_flutter/animations/premium_animations.dart';
import 'match_animation_screen.dart';
import '../widgets/out_of_likes_dialog.dart';

class SwipeScreen extends StatefulWidget {
  const SwipeScreen({super.key});

  @override
  State<SwipeScreen> createState() => _SwipeScreenState();
}

class _SwipeScreenState extends State<SwipeScreen> {
  final CardSwiperController _controller = CardSwiperController();
  List<Map<String, dynamic>> _potentialMatches = [];
  bool _loading = true;
  bool _isProcessingSwipe = false;
  Map<String, dynamic>? _currentUser;
  String? _error;
  double _parallaxValue = 0;

  @override
  void initState() {
    super.initState();
    _loadPotentialMatches();
  }

  Future<void> _loadPotentialMatches() async {
    if (!mounted) return;
    setState(() {
      _loading = true;
      _error = null;
    });
    try {
      final matches = await ApiService.getPotentialMatches();
      final currentUser = await ApiService.getProfile();
      if (mounted) {
        setState(() {
          _potentialMatches = matches;
          _currentUser = currentUser;
        });
      }
    } catch (e) {
      if (mounted) {
        setState(() => _error = e.toString());
      }
    }

    if (mounted) {
      setState(() => _loading = false);
    }
  }

  Future<bool> _handleSwipe(int previousIndex, int? currentIndex,
      CardSwiperDirection direction) async {
    if (_isProcessingSwipe) return false;
    if (!mounted) return false;

    setState(() => _isProcessingSwipe = true);

    final user = _potentialMatches[previousIndex];
    final liked = direction == CardSwiperDirection.right;
    final superLiked = direction == CardSwiperDirection.top;

    try {
      final result = await ApiService.recordSwipe(user['_id'], liked, superLiked);
      if (result['match']) {
        if (mounted) {
          Navigator.of(context).push(
            PageRouteBuilder(
              pageBuilder: (context, animation, secondaryAnimation) =>
                  MatchAnimationScreen(
                    currentUserImageUrl: _currentUser?['images']?[0] != null
                        ? ApiService.resolveAssetUrl(_currentUser!['images'][0])
                        : 'assets/default_avatar.png',
                    currentUserId: _currentUser?['_id']?.toString() ?? '',
                    user2ImageUrl: user['images']?[0] != null
                        ? ApiService.resolveAssetUrl(user['images'][0])
                        : 'assets/default_avatar.png',
                    matchedUser: user,
                  ),
              transitionsBuilder: (context, animation, secondaryAnimation, child) {
                return FadeTransition(opacity: animation, child: child);
              },
            ),
          );
        }
      }
      if (result['limitReached'] == true) {
        if (mounted) {
          showDialog(
            context: context,
            builder: (context) => const OutOfLikesDialog(),
          );
        }
        return false;
      }
      if (mounted) setState(() => _isProcessingSwipe = false);
      return true;
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Error recording swipe: $e')),
        );
      }
      if (mounted) setState(() => _isProcessingSwipe = false);
      return false;
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.transparent,
      body: RefreshIndicator(
        onRefresh: _loadPotentialMatches,
        backgroundColor: Theme.of(context).colorScheme.surface,
        color: Theme.of(context).primaryColor,
        child: SafeArea(
          child: _loading
              ? _buildLoadingState()
              : _error != null
                  ? _buildErrorState()
                  : _potentialMatches.isEmpty
                      ? _buildEmptyState()
                      : _buildSwiper(),
        ),
      ),
    );
  }

  Widget _buildLoadingState() {
    return const Center(
      key: Key('swipeLoadingIndicator'),
      child: PremiumLoadingIndicator(
        key: Key('swipeLoadingProgress'),
      ),
    );
  }

  Widget _buildErrorState() {
    return Center(
      key: const Key('swipeErrorState'),
      child: Padding(
        padding: const EdgeInsets.all(24.0),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Icon(Icons.error_outline,
                key: Key('swipeErrorIcon'),
                color: Colors.redAccent,
                size: 60),
            const SizedBox(height: 16),
            Text(
              'Error: $_error',
              textAlign: TextAlign.center,
              style: const TextStyle(fontSize: 16, color: Colors.white70),
            ),
            const SizedBox(height: 16),
            ElevatedButton.icon(
              key: const Key('swipeRetryButton'),
              onPressed: _loadPotentialMatches,
              icon: const Icon(Icons.refresh),
              label: const Text('Try Again'),
              style: ElevatedButton.styleFrom(
                backgroundColor: Theme.of(context).primaryColor,
              ),
            )
          ],
        ),
      ),
    );
  }

  Widget _buildEmptyState() {
    return Center(
      key: const Key('swipeEmptyState'),
      child: Padding(
        padding: const EdgeInsets.all(24.0),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Icon(Icons.hourglass_empty,
                key: Key('swipeEmptyIcon'),
                size: 60,
                color: Colors.white54),
            const SizedBox(height: 16),
            const Text(
              'No new matches right now.',
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 8),
            const Text(
              'Check back later!',
              style: TextStyle(fontSize: 16, color: Colors.white70),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildSwiper({Key? key}) {
    return Column(
      key: key,
      children: [
        Padding(
          padding: const EdgeInsets.all(16.0),
          child: Text(
            'Discover',
            key: const Key('discoverTitle'),
            style: Theme.of(context).textTheme.headlineMedium?.copyWith(
                  fontWeight: FontWeight.bold,
                  color: Colors.white,
                ),
          ),
        ),
        Expanded(
          child: CardSwiper(
            key: const Key('profileCardSwiper'),
            controller: _controller,
            cardsCount: _potentialMatches.length,
            onSwipe: _handleSwipe,
            padding: const EdgeInsets.symmetric(horizontal: 24.0, vertical: 12.0),
            allowedSwipeDirection: _currentUser?['premium'] == true
                ? AllowedSwipeDirection.symmetric(horizontal: true, vertical: true)
                : AllowedSwipeDirection.symmetric(horizontal: true, vertical: false),
            cardBuilder: (context, index, horizontalThresholdPercentage,
                verticalThresholdPercentage) {
              final user = _potentialMatches[index];
              final images = user['images'] as List?;
              final hasImage = images != null && images.isNotEmpty;

              return ClipRRect(
                key: Key('profileCard$index'),
                borderRadius: BorderRadius.circular(20),
                child: Stack(
                  fit: StackFit.expand,
                  children: [
                    // Profile Image with Parallax
                    Transform.translate(
                      offset: Offset(0, horizontalThresholdPercentage * 10),
                      child: hasImage
                          ? CachedNetworkImage(
                              imageUrl:
                                  ApiService.resolveAssetUrl(images[0]),
                              fit: BoxFit.cover,
                              placeholder: (context, url) =>
                                  Container(color: Colors.grey[900]),
                              errorWidget: (context, url, error) => Container(
                                color: Colors.grey[900],
                                child: Icon(Icons.person,
                                    size: 100, color: Colors.grey[700]),
                              ),
                            )
                          : Container(
                              color: Colors.grey[900],
                              child: Icon(Icons.person,
                                  size: 100, color: Colors.grey[700]),
                            ),
                    ),

                    // Gradient Overlay with Blur
                    ClipRRect(
                      child: BackdropFilter(
                        filter: ImageFilter.blur(
                          sigmaX: horizontalThresholdPercentage * 5,
                          sigmaY: horizontalThresholdPercentage * 5,
                        ),
                        child: Container(
                          decoration: BoxDecoration(
                            gradient: LinearGradient(
                              begin: Alignment.bottomCenter,
                              end: Alignment.topCenter,
                              colors: [
                                Colors.black
                                    .withAlpha((220 * (1 - horizontalThresholdPercentage * 0.5)).toInt()),
                                Colors.black.withAlpha((51 * (1 - horizontalThresholdPercentage * 0.5)).toInt()),
                              ],
                            ),
                          ),
                        ),
                      ),
                    ),

                    // Info with Premium Shadow
                    _buildGlassmorphicInfo(user),
                  ],
                ),
              );
            },
          ),
        ),
        _buildActionButtons(),
      ],
    );
  }

  Widget _buildGlassmorphicInfo(Map<String, dynamic> user) {
    return Positioned(
      bottom: 0,
      left: 0,
      right: 0,
      child: ClipRRect(
        child: BackdropFilter(
          filter: ImageFilter.blur(sigmaX: 8.0, sigmaY: 8.0),
          child: Container(
            padding: const EdgeInsets.all(20.0),
            decoration: BoxDecoration(
              boxShadow: PremiumAnimations.premiumGlow(
                color: Colors.black,
                intensity: 0.8,
              ),
              gradient: LinearGradient(
                begin: Alignment.bottomCenter,
                end: Alignment.topCenter,
                colors: [
                  Colors.black.withAlpha(179),
                  Colors.black.withAlpha(51),
                ],
              ),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              mainAxisSize: MainAxisSize.min,
              children: [
                Text(
                  '${user['name'] ?? 'N/A'}, ${user['age'] ?? 'N/A'}',
                  key: const Key('profileNameAge'),
                  style: const TextStyle(
                    fontSize: 28,
                    fontWeight: FontWeight.bold,
                    color: Colors.white,
                    shadows: [Shadow(blurRadius: 4, color: Colors.black87)],
                  ),
                ),
                const SizedBox(height: 8),
                Text(
                  user['bio'] ?? 'No bio available.',
                  key: const Key('profileBio'),
                  maxLines: 2,
                  overflow: TextOverflow.ellipsis,
                  style: TextStyle(
                    fontSize: 16,
                    color: Colors.white.withAlpha(230),
                    height: 1.4,
                    shadows: const [
                      Shadow(blurRadius: 2, color: Colors.black54)
                    ],
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  Widget _buildActionButtons() {
    return Padding(
      key: const Key('actionButtons'),
      padding: const EdgeInsets.symmetric(vertical: 20.0),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceEvenly,
        children: [
          _buildActionButton(
            key: const Key('nopeButton'),
            icon: Icons.close,
            color: Colors.redAccent,
            onTap: () => _controller.swipeLeft(),
          ),
          _buildActionButton(
            key: const Key('superLikeButton'),
            icon: Icons.star,
            color: _currentUser?['premium'] == true
                ? Colors.blueAccent
                : Colors.grey,
            size: 32,
            onTap: () {
              if (_currentUser?['premium'] == true) {
                _controller.swipeTop();
              } else {
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(
                    content: const Text('Super Like requires premium membership'),
                    action: SnackBarAction(
                      label: 'Get Premium',
                      onPressed: () =>
                          Navigator.pushNamed(context, '/payments'),
                    ),
                  ),
                );
              }
            },
          ),
          _buildActionButton(
            key: const Key('likeButton'),
            icon: Icons.favorite,
            color: Colors.greenAccent,
            onTap: () => _controller.swipeRight(),
          ),
        ],
      ),
    );
  }

  Widget _buildActionButton({
    Key? key,
    required IconData icon,
    required Color color,
    VoidCallback? onTap,
    double size = 40,
  }) {
    return GestureDetector(
      key: key,
      onTap: onTap,
      child: ScaleTransition(
        scale: AlwaysStoppedAnimation(1.0),
        child: Container(
          padding: const EdgeInsets.all(16),
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            color: Theme.of(context).colorScheme.surface.withAlpha(204),
            boxShadow: PremiumAnimations.premiumGlow(
              color: color,
              intensity: 0.6,
            ),
          ),
          child: Icon(icon, color: color, size: size),
        ),
      ),
    );
  }
}