import 'package:geolocator/geolocator.dart';
import 'package:geocoding/geocoding.dart';
import 'package:http/http.dart' as http;
import 'dart:convert';
import '../models/emergency_contact.dart';

/// Handles emergency location sharing and notifications
class EmergencyService {
  static final EmergencyService _instance = EmergencyService._internal();

  late Geolocator _geolocator;
  late bool _locationPermissionGranted;

  factory EmergencyService() {
    return _instance;
  }

  EmergencyService._internal();

  /// Initialize emergency service
  Future<void> initialize() async {
    _geolocator = Geolocator();
    await _requestLocationPermission();
  }

  /// Request location permission
  Future<void> _requestLocationPermission() async {
    final permission = await Geolocator.requestPermission();
    _locationPermissionGranted = permission == LocationPermission.always ||
        permission == LocationPermission.whileInUse;
  }

  /// Get current location with high accuracy
  Future<LocationData?> getCurrentLocation() async {
    try {
      if (!_locationPermissionGranted) {
        await _requestLocationPermission();
      }

      final position = await Geolocator.getCurrentPosition(
        desiredAccuracy: LocationAccuracy.best,
        timeLimit: const Duration(seconds: 30),
      );

      // Get address from coordinates
      String? address;
      try {
        final placemarks = await placemarkFromCoordinates(
          position.latitude,
          position.longitude,
        );
        if (placemarks.isNotEmpty) {
          final place = placemarks.first;
          address =
              '${place.street}, ${place.locality}, ${place.postalCode}, ${place.country}';
        }
      } catch (e) {
        print('Error getting address: $e');
      }

      return LocationData(
        latitude: position.latitude,
        longitude: position.longitude,
        accuracy: position.accuracy,
        timestamp: DateTime.now(),
        address: address,
      );
    } catch (e) {
      print('Error getting location: $e');
      return null;
    }
  }

  /// Send location to emergency contact (with direct message)
  Future<bool> shareLocationWithContact({
    required String userId,
    required EmergencyContact contact,
    required LocationData location,
    required EmergencyServiceType serviceType,
  }) async {
    try {
      // Send location via backend
      final response = await http.post(
        Uri.parse('http://localhost:5000/api/emergency/share-location'),
        headers: {'Content-Type': 'application/json'},
        body: jsonEncode({
          'userId': userId,
          'contactId': contact.id,
          'contactEmail': contact.email,
          'contactPhone': contact.phoneNumber,
          'contactName': contact.name,
          'location': location.toJson(),
          'serviceType': serviceType.name,
          'timestamp': DateTime.now().toIso8601String(),
        }),
      ).timeout(const Duration(seconds: 15));

      if (response.statusCode == 200) {
        // ✅ NEW: Also send as direct message
        await _sendLocationAsDirectMessage(
          userId: userId,
          contactId: contact.id,
          contactName: contact.name,
          location: location,
          serviceType: serviceType,
        );
        return true;
      }
      return false;
    } catch (e) {
      print('Error sharing location: $e');
      return false;
    }
  }

  /// ✅ NEW: Send location as direct message in app
  Future<void> _sendLocationAsDirectMessage({
    required String userId,
    required String contactId,
    required String contactName,
    required LocationData location,
    required EmergencyServiceType serviceType,
  }) async {
    try {
      // Create location message
      final locationMessage = _formatLocationMessage(
        contactName,
        location,
        serviceType,
      );

      // Send as direct message
      await http.post(
        Uri.parse('http://localhost:5000/api/messages/send'),
        headers: {'Content-Type': 'application/json'},
        body: jsonEncode({
          'fromUserId': userId,
          'toUserId': contactId,
          'type': 'location_share',
          'content': locationMessage,
          'locationData': location.toJson(),
          'serviceType': serviceType.name,
          'timestamp': DateTime.now().toIso8601String(),
          'isEmergency': true,
          'priority': 'high',
        }),
      ).timeout(const Duration(seconds: 10));

      print('Location message sent to $contactName');
    } catch (e) {
      print('Error sending location message: $e');
    }
  }

  /// Format location message for direct message
  String _formatLocationMessage(
    String contactName,
    LocationData location,
    EmergencyServiceType serviceType,
  ) {
    final emoji = _getServiceEmoji(serviceType);
    final timeStr = DateTime.now().toString().split('.')[0];

    return '''$emoji EMERGENCY LOCATION SHARE

I'm sharing my location with you for safety purposes.

📍 Location: ${location.address ?? 'Coordinates available'}
🌐 Coordinates: ${location.latitude.toStringAsFixed(4)}, ${location.longitude.toStringAsFixed(4)}
📏 Accuracy: ±${location.accuracy.toInt()} meters
⏰ Time: $timeStr

Type: ${serviceType.label}

👉 Tap to open in Maps''';
  }

  /// Get emoji for service type
  String _getServiceEmoji(EmergencyServiceType serviceType) {
    switch (serviceType) {
      case EmergencyServiceType.favourite:
        return '❤️';
      case EmergencyServiceType.police:
        return '🚨';
      case EmergencyServiceType.hospital:
        return '🏥';
      case EmergencyServiceType.emergency:
        return '📞';
    }
  }

  /// Send emergency alert to multiple contacts (with messages)
  Future<int> sendEmergencyAlert({
    required String userId,
    required List<EmergencyContact> contacts,
    required LocationData location,
    String? message,
  }) async {
    int successCount = 0;

    for (final contact in contacts) {
      final success = await shareLocationWithContact(
        userId: userId,
        contact: contact,
        location: location,
        serviceType: EmergencyServiceType.favourite,
      );

      if (success) {
        successCount++;
      }
    }

    return successCount;
  }

  /// Send SOS to police (with message)
  Future<bool> sendSOSToPolice({
    required String userId,
    required LocationData location,
    String? incidentType,
  }) async {
    try {
      final response = await http.post(
        Uri.parse('http://localhost:5000/api/emergency/send-sos'),
        headers: {'Content-Type': 'application/json'},
        body: jsonEncode({
          'userId': userId,
          'location': location.toJson(),
          'incidentType': incidentType ?? 'Safety Concern',
          'timestamp': DateTime.now().toIso8601String(),
        }),
      ).timeout(const Duration(seconds: 10));

      if (response.statusCode == 200) {
        // ✅ NEW: Create audit log message
        await _logSOSAlert(userId, location, incidentType);
        return true;
      }
      return false;
    } catch (e) {
      print('Error sending SOS: $e');
      return false;
    }
  }

  /// Log SOS alert
  Future<void> _logSOSAlert(
    String userId,
    LocationData location,
    String? incidentType,
  ) async {
    try {
      await http.post(
        Uri.parse('http://localhost:5000/api/emergency/log-sos'),
        headers: {'Content-Type': 'application/json'},
        body: jsonEncode({
          'userId': userId,
          'location': location.toJson(),
          'incidentType': incidentType,
          'timestamp': DateTime.now().toIso8601String(),
        }),
      ).timeout(const Duration(seconds: 10));
    } catch (e) {
      print('Error logging SOS: $e');
    }
  }

  /// Get nearby emergency services
  Future<List<Map<String, dynamic>>> getNearbyEmergencyServices(
    double latitude,
    double longitude,
  ) async {
    try {
      final response = await http.get(
        Uri.parse(
          'http://localhost:5000/api/emergency/nearby?lat=$latitude&lng=$longitude',
        ),
        headers: {'Accept': 'application/json'},
      ).timeout(const Duration(seconds: 15));

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        return List<Map<String, dynamic>>.from(data['services'] ?? []);
      }
      return [];
    } catch (e) {
      print('Error getting nearby services: $e');
      return [];
    }
  }

  /// Call emergency number
  Future<bool> callEmergencyNumber(String phoneNumber) async {
    try {
      // Use url_launcher to initiate call
      // await launchUrl(Uri(scheme: 'tel', path: phoneNumber));
      return true;
    } catch (e) {
      print('Error calling emergency: $e');
      return false;
    }
  }

  /// Log emergency share
  Future<void> logEmergencyShare({
    required String userId,
    required EmergencyContact contact,
    required LocationData location,
    required EmergencyServiceType serviceType,
    required bool acknowledged,
  }) async {
    try {
      await http.post(
        Uri.parse('http://localhost:5000/api/emergency/log-share'),
        headers: {'Content-Type': 'application/json'},
        body: jsonEncode({
          'userId': userId,
          'contactId': contact.id,
          'contactName': contact.name,
          'location': location.toJson(),
          'serviceType': serviceType.name,
          'timestamp': DateTime.now().toIso8601String(),
          'acknowledged': acknowledged,
        }),
      ).timeout(const Duration(seconds: 10));
    } catch (e) {
      print('Error logging emergency share: $e');
    }
  }

  /// Get emergency contact history
  Future<List<EmergencyShareLog>> getEmergencyHistory(String userId) async {
    try {
      final response = await http.get(
        Uri.parse('http://localhost:5000/api/emergency/history/$userId'),
        headers: {'Accept': 'application/json'},
      ).timeout(const Duration(seconds: 15));

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        return (data['history'] as List)
            .map((item) => EmergencyShareLog.fromJson(item))
            .toList();
      }
      return [];
    } catch (e) {
      print('Error getting history: $e');
      return [];
    }
  }

  /// Get default emergency numbers by country
  static Map<String, String> getEmergencyNumbers(String countryCode) {
    const emergencyMap = {
      'US': '911',
      'UK': '999',
      'EU': '112',
      'CA': '911',
      'AU': '000',
      'JP': '110',
      'IN': '100',
      'MX': '066',
    };

    return {
      'police': emergencyMap[countryCode] ?? '911',
      'ambulance': emergencyMap[countryCode] ?? '911',
      'fire': emergencyMap[countryCode] ?? '911',
    };
  }
}
