import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../models/meengle_spotlight.dart';
import '../providers/spotlight_provider.dart';

class SpotlightScreen extends StatefulWidget {
  const SpotlightScreen({super.key});

  @override
  State<SpotlightScreen> createState() => _SpotlightScreenState();
}

class _SpotlightScreenState extends State<SpotlightScreen> {
  @override
  void initState() {
    super.initState();
    Future.microtask(() {
      if (mounted) {
        const userId = 'current_user_id'; // Set from auth provider in production
        final provider = context.read<SpotlightProvider>();
        provider.checkActive(userId);
        provider.loadHistory(userId);
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF0F0F0F),
      appBar: AppBar(
        backgroundColor: const Color(0xFF1A1A1A),
        title: const Text('SPOTLIGHT', style: TextStyle(fontWeight: FontWeight.bold, letterSpacing: 1)),
        centerTitle: true,
        elevation: 0,
      ),
      body: Consumer<SpotlightProvider>(
        builder: (context, provider, _) {
          if (provider.isLoading) {
            return Center(child: CircularProgressIndicator(color: Colors.amber.shade700));
          }

          return SingleChildScrollView(
            padding: const EdgeInsets.all(16),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                // Status Card
                Container(
                  width: double.infinity,
                  decoration: BoxDecoration(
                    color: provider.activeSpotlight != null ? Colors.green[900] : Colors.grey[900],
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(
                      color: provider.activeSpotlight != null ? Colors.green : Colors.amber.shade700,
                      width: 2,
                    ),
                  ),
                  padding: const EdgeInsets.all(20),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(
                        mainAxisAlignment: MainAxisAlignment.spaceBetween,
                        children: [
                          const Text('Status', style: TextStyle(color: Colors.white70, fontSize: 12)),
                          Container(
                            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                            decoration: BoxDecoration(
                              color: provider.activeSpotlight != null ? Colors.green : Colors.orange,
                              borderRadius: BorderRadius.circular(20),
                            ),
                            child: Text(
                              provider.activeSpotlight != null ? 'ACTIVE' : 'INACTIVE',
                              style: const TextStyle(
                                color: Colors.white,
                                fontWeight: FontWeight.bold,
                                fontSize: 11,
                              ),
                            ),
                          ),
                        ],
                      ),
                      const SizedBox(height: 16),
                      if (provider.activeSpotlight != null) ...[
                        const Text('Profile Boost Active', style: TextStyle(color: Colors.white, fontSize: 18, fontWeight: FontWeight.bold)),
                        const SizedBox(height: 8),
                        Text(
                          'Expires ${provider.activeSpotlight!.expiresAt.difference(DateTime.now()).inDays} days from now',
                          style: const TextStyle(color: Colors.white70, fontSize: 12),
                        ),
                        const SizedBox(height: 16),
                        Container(
                          padding: const EdgeInsets.all(12),
                          decoration: BoxDecoration(
                            color: Colors.green.withValues(alpha: 0.2),
                            borderRadius: BorderRadius.circular(8),
                          ),
                          child: Row(
                            children: [
                              Icon(Icons.visibility, color: Colors.green.shade300),
                              const SizedBox(width: 12),
                              Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  const Text('Tier', style: TextStyle(color: Colors.white70, fontSize: 11)),
                                  Text(
                                    provider.activeSpotlight!.tier.toString().split('.').last.toUpperCase(),
                                    style: const TextStyle(color: Colors.white, fontSize: 18, fontWeight: FontWeight.bold),
                                  ),
                                ],
                              ),
                            ],
                          ),
                        ),
                      ] else ...[
                        const Text('Boost Your Profile', style: TextStyle(color: Colors.white, fontSize: 18, fontWeight: FontWeight.bold)),
                        const SizedBox(height: 8),
                        const Text(
                          'Get featured and receive more profile visits',
                          style: TextStyle(color: Colors.white70, fontSize: 12),
                        ),
                      ],
                    ],
                  ),
                ),
                const SizedBox(height: 24),

                // History
                if (provider.history.isNotEmpty) ...[
                  const Text('Boost History', style: TextStyle(color: Colors.white, fontSize: 14, fontWeight: FontWeight.bold)),
                  const SizedBox(height: 12),
                  ...provider.history.map((s) => Padding(
                    padding: const EdgeInsets.only(bottom: 8),
                    child: Container(
                      decoration: BoxDecoration(
                        color: const Color(0xFF1A1A1A),
                        borderRadius: BorderRadius.circular(8),
                        border: Border.all(color: Colors.white10, width: 1),
                      ),
                      padding: const EdgeInsets.all(12),
                      child: Row(
                        mainAxisAlignment: MainAxisAlignment.spaceBetween,
                        children: [
                          Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Text(
                                s.tier.toString().split('.').last.toUpperCase(),
                                style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold),
                              ),
                              Text(
                                '${s.startedAt.difference(DateTime.now()).inDays} days ago',
                                style: const TextStyle(color: Colors.white70, fontSize: 11),
                              ),
                            ],
                          ),
                          Container(
                            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                            decoration: BoxDecoration(
                              color: s.isActive ? Colors.green : Colors.orange,
                              borderRadius: BorderRadius.circular(4),
                            ),
                            child: Text(
                              s.isActive ? 'ACTIVE' : 'EXPIRED',
                              style: const TextStyle(color: Colors.white, fontSize: 9, fontWeight: FontWeight.bold),
                            ),
                          ),
                        ],
                      ),
                    ),
                  )),
                  const SizedBox(height: 24),
                ],

                // Packages
                const Text('Boost Packages', style: TextStyle(color: Colors.white, fontSize: 14, fontWeight: FontWeight.bold)),
                const SizedBox(height: 12),
                _SpotlightPackage(
                  tier: SpotlightTier.bronze,
                  title: 'Bronze Boost',
                  price: 0,
                  onPurchase: () => context.read<SpotlightProvider>().purchaseSpotlight('current_user_id', SpotlightTier.bronze),
                ),
                const SizedBox(height: 8),
                _SpotlightPackage(
                  tier: SpotlightTier.silver,
                  title: 'Silver Shine',
                  price: 99,
                  onPurchase: () => context.read<SpotlightProvider>().purchaseSpotlight('current_user_id', SpotlightTier.silver),
                ),
                const SizedBox(height: 8),
                _SpotlightPackage(
                  tier: SpotlightTier.gold,
                  title: 'Gold Star',
                  price: 299,
                  popular: true,
                  onPurchase: () => context.read<SpotlightProvider>().purchaseSpotlight('current_user_id', SpotlightTier.gold),
                ),
                const SizedBox(height: 8),
                _SpotlightPackage(
                  tier: SpotlightTier.platinum,
                  title: 'Platinum Elite',
                  price: 799,
                  onPurchase: () => context.read<SpotlightProvider>().purchaseSpotlight('current_user_id', SpotlightTier.platinum),
                ),
              ],
            ),
          );
        },
      ),
    );
  }
}

class _SpotlightPackage extends StatelessWidget {
  final SpotlightTier tier;
  final String title;
  final int price;
  final bool popular;
  final VoidCallback onPurchase;

  const _SpotlightPackage({
    required this.tier,
    required this.title,
    required this.price,
    this.popular = false,
    required this.onPurchase,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        color: const Color(0xFF1A1A1A),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(
          color: popular ? Colors.amber.shade700 : Colors.amber.shade700.withValues(alpha: 0.3),
          width: popular ? 2 : 1,
        ),
      ),
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Text(
                title,
                style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 14),
              ),
              if (popular)
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                  decoration: BoxDecoration(
                    color: Colors.amber.shade700,
                    borderRadius: BorderRadius.circular(4),
                  ),
                  child: const Text(
                    'POPULAR',
                    style: TextStyle(color: Colors.black, fontSize: 9, fontWeight: FontWeight.bold),
                  ),
                ),
            ],
          ),
          const SizedBox(height: 12),
          Text('$price tokens', style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 20)),
          const SizedBox(height: 12),
          SizedBox(
            width: double.infinity,
            child: ElevatedButton(
              onPressed: onPurchase,
              style: ElevatedButton.styleFrom(
                backgroundColor: popular ? Colors.amber.shade700 : Colors.grey[800],
                shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
              ),
              child: Text(
                'Purchase',
                style: TextStyle(
                  color: popular ? Colors.black : Colors.white,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
}
