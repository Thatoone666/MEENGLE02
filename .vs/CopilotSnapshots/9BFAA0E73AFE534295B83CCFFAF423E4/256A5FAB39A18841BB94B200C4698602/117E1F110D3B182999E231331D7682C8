describe('Matching Routes', () => {
  let token1, token2, userId1, userId2;

  beforeAll(async () => {
    const res1 = await request(app)
      .post('/api/auth/signup')
      .send({
        email: 'match1@test.com',
        password: 'TestPass123',
        name: 'Match User 1',
        gender: 'male'
      });
    token1 = res1.body.token;
    userId1 = res1.body.user.id;

    const res2 = await request(app)
      .post('/api/auth/signup')
      .send({
        email: 'match2@test.com',
        password: 'TestPass123',
        name: 'Match User 2',
        gender: 'female'
      });
    token2 = res2.body.token;
    userId2 = res2.body.user.id;
  });

  test('POST /api/matches/like - valid', async () => {
    const res = await request(app)
      .post('/api/matches/like')
      .set('Authorization', `Bearer ${token1}`)
      .send({ targetUserId: userId2 });
    expect(res.statusCode).toBe(200);
  });

  test('POST /api/matches/like - duplicate', async () => {
    const res = await request(app)
      .post('/api/matches/like')
      .set('Authorization', `Bearer ${token1}`)
      .send({ targetUserId: userId2 });
    expect(res.statusCode).toBe(400);
  });

  test('GET /api/matches/count', async () => {
    const res = await request(app)
      .get('/api/matches/count')
      .set('Authorization', `Bearer ${token1}`);
    expect(res.statusCode).toBe(200);
    expect(res.body.count).toBe(0);
  });
});

