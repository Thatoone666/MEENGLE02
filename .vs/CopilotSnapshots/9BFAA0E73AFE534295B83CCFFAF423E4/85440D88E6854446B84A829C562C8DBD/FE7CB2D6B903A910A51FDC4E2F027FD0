{
  "env": {
    "node": true,
    "es2021": true,
    "mocha": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["log", "error", "warn"] }]
  },
  "ignorePatterns": ["node_modules/", "dist/", "build/", "tests/**/*.js", "**/*.test.js"]
}
