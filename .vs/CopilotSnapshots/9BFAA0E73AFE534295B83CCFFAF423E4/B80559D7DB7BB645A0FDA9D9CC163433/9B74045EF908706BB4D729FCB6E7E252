import express from 'express';
import crypto from 'crypto';
import mongoose from 'mongoose';

const router = express.Router();

router.post('/stripe', async (req, res) => {
  try {
    const sig = req.headers['stripe-signature'];
    const webhookSecret = process.env.STRIPE_WEBHOOK_SECRET;

    if (!webhookSecret) {
      return res.json({ received: true });
    }

    let event;
    try {
      event = JSON.parse(req.body);
    } catch (err) {
      return res.status(400).send(`Webhook Error: ${err.message}`);
    }

    const Invoice = mongoose.model('Invoice');
    const Subscription = mongoose.model('Subscription');

    if (event.type === 'payment_intent.succeeded') {
      const paymentIntent = event.data.object;

      await Invoice.findOneAndUpdate(
        { externalPaymentId: paymentIntent.id },
        {
          status: 'completed',
          completedAt: new Date(),
          externalReference: paymentIntent.id
        }
      );
    }

    if (event.type === 'customer.subscription.updated') {
      const subscription = event.data.object;

      if (subscription.cancel_at_period_end) {
        await Subscription.findOneAndUpdate(
          { externalSubscriptionId: subscription.id },
          { status: 'cancelled', cancellationDate: new Date() }
        );
      }
    }

    res.json({ received: true });
  } catch (error) {
    console.error('Stripe webhook error:', error);
    res.status(500).json({ error: 'Webhook processing failed' });
  }
});

router.post('/payfast', async (req, res) => {
  try {
    const { m_payment_id, pf_payment_id, payment_status } = req.body;

    const merchantKey = process.env.PAYFAST_MERCHANT_KEY;
    const expectedSignature = generatePayFastSignature(req.body, merchantKey);

    if (req.body.signature !== expectedSignature) {
      return res.status(400).json({ error: 'Invalid signature' });
    }

    const Invoice = mongoose.model('Invoice');

    if (payment_status === 'COMPLETE') {
      await Invoice.findOneAndUpdate(
        { externalPaymentId: pf_payment_id },
        {
          status: 'completed',
          completedAt: new Date(),
          externalReference: pf_payment_id
        }
      );
    } else if (payment_status === 'FAILED') {
      await Invoice.findOneAndUpdate(
        { externalPaymentId: pf_payment_id },
        {
          status: 'failed',
          failureReason: 'PayFast payment failed'
        }
      );
    }

    res.json({ received: true });
  } catch (error) {
    console.error('PayFast webhook error:', error);
    res.status(500).json({ error: 'Webhook processing failed' });
  }
});

router.post('/yoco', async (req, res) => {
  try {
    const event = req.body;
    const webhookSecret = process.env.YOCO_WEBHOOK_SECRET;

    const signature = crypto
      .createHmac('sha256', webhookSecret)
      .update(JSON.stringify(event))
      .digest('base64');

    if (req.headers['x-yoco-signature'] !== signature) {
      return res.status(400).json({ error: 'Invalid signature' });
    }

    const Invoice = mongoose.model('Invoice');

    if (event.type === 'payment.successful') {
      await Invoice.findOneAndUpdate(
        { externalPaymentId: event.data.id },
        {
          status: 'completed',
          completedAt: new Date()
        }
      );
    }

    if (event.type === 'payment.failed') {
      await Invoice.findOneAndUpdate(
        { externalPaymentId: event.data.id },
        {
          status: 'failed',
          failureReason: 'Yoco payment failed'
        }
      );
    }

    res.json({ received: true });
  } catch (error) {
    console.error('Yoco webhook error:', error);
    res.status(500).json({ error: 'Webhook processing failed' });
  }
});

router.post('/ozow', async (req, res) => {
  try {
    const { TransactionReference, Status, TransactionID } = req.body;
    const Invoice = mongoose.model('Invoice');

    if (Status === 'Complete') {
      await Invoice.findOneAndUpdate(
        { externalPaymentId: TransactionID },
