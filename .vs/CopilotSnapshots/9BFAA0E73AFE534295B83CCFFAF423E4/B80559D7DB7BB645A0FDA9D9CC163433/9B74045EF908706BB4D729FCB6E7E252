});

router.post('/snapscan', async (req, res) => {
  try {
    const { transactionId, status } = req.body;
    const Invoice = mongoose.model('Invoice');

    if (status === 'SETTLED') {
      await Invoice.findOneAndUpdate(
        { externalPaymentId: transactionId },
        {
          status: 'completed',
          completedAt: new Date()
        }
      );
    } else if (status === 'FAILED') {
      await Invoice.findOneAndUpdate(
        { externalPaymentId: transactionId },
        { status: 'failed' }
      );
    }

    res.json({ received: true });
  } catch (error) {
    console.error('Snapscan webhook error:', error);
    res.status(500).json({ error: 'Webhook processing failed' });
  }
});

function generatePayFastSignature(data, merchantKey) {
  const sortedData = Object.keys(data)
    .filter(key => key !== 'signature')
    .sort()
    .reduce((result, key) => {
      result[key] = data[key];
      return result;
    }, {});

  const signatureString = Object.entries(sortedData)
    .map(([key, value]) => `${key}=${value}`)
    .join('&');

  const stringToHash = `${signatureString}&${merchantKey}`;
  return crypto.createHash('md5').update(stringToHash).digest('hex');
}

export default router;
