import express from 'express';
import auth from '../middleware/auth.js';
import fcmService from '../lib/fcm_service.js';
import User from '../models/User.js';

const router = express.Router();

// Send test notification
router.post('/send-test', auth, async (req, res) => {
  try {
    const user = await User.findById(req.user.id);
    if (!user || !user.fcmToken) {
      return res.status(400).json({ success: false, error: 'No FCM token found' });
    }

    const result = await fcmService.sendToUser(user.fcmToken, {
      title: 'Test Notification',
      body: 'This is a test notification from Meengle',
      data: {
        type: 'test',
      }
    });

    res.json(result);
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

// Send story view notification
router.post('/story-view/:storyId', auth, async (req, res) => {
  try {
    const { viewerName } = req.body;
    const storyId = req.params.storyId;

    // Get story to find owner
    const { Story } = require('../models/featureModels');
    const story = await Story.findById(storyId);
    if (!story) {
      return res.status(404).json({ success: false, error: 'Story not found' });
    }

    const owner = await User.findById(story.userId);
    if (!owner || !owner.fcmToken) {
      return res.status(400).json({ success: false, error: 'Owner FCM token not found' });
    }

    const result = await fcmService.notifyStoryView(owner._id, owner.fcmToken, {
      storyId: storyId,
      viewedBy: req.user.id,
      viewerName: viewerName || 'Someone'
    });

    res.json(result);
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

