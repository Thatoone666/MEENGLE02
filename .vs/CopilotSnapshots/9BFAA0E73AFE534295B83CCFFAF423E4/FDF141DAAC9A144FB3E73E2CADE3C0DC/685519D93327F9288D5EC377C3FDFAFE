// Send match notification
router.post('/match/:userId', auth, async (req, res) => {
  try {
    const userId = req.params.userId;
    const { matchName } = req.body;

    const user = await User.findById(userId);
    if (!user || !user.fcmToken) {
      return res.status(400).json({ success: false, error: 'User FCM token not found' });
    }

    const result = await fcmService.notifyNewMatch(userId, user.fcmToken, {
      matchId: [req.user.id, userId].sort().join('-'),
      matchUserId: req.user.id,
      matchName: matchName || 'Someone'
    });

    res.json(result);
  } catch (error) {
    res.status(500).json({ success: false, error: error.message });
  }
});

