import express from 'express';
import http from 'http';
import { Server } from 'socket.io';
import path from 'path';
import compression from 'compression';
import helmet from 'helmet';
import dotenv from 'dotenv';
import { fileURLToPath } from 'url';
import mongoose from 'mongoose';
import { errorHandler } from './middleware/errorHandler.js';
import { sanitizeInput, securityHeaders, validateContentLength } from './middleware/security.js';
import { metricsMiddleware, logMiddleware, errorLogger, healthCheck } from './services/monitoringService.js';
import { scheduleAutoBackup } from './services/backupService.js';
import { analyzeUserBehavior } from './services/suspiciousAccountDetection.js';
import { authRouter } from './routes/auth.js';
import matchingRouter from './routes/matching.js';
import chatRouter, { Message } from './routes/chat.js';
import paymentsRouter from './routes/payments.js';
import paymentRouter from './routes/payment.js';
import boostsRouter from './routes/boosts.js';
import verifyRouter from './routes/verify.js';
import promptsRouter from './routes/prompts.js';
import momentsRouter from './routes/moments.js';
import notesRouter from './routes/notes.js';
import circlesRouter from './routes/circles.js';
import storiesRouter from './routes/stories.js';
import datesRouter from './routes/dates.js';
import spotlightRouter from './routes/spotlight.js';
import roamRouter from './routes/roam.js';
import discoveryRouter from './routes/discovery.js';
import categoriesRouter from './routes/categories.js';
import messagesRouter from './routes/messages.js';
import locationchatRouter from './routes/locationchat.js';
import emergencyRouter from './routes/emergency.js';
import fraudRouter from './routes/fraud.js';
import notificationsRouter from './routes/notifications.js';
import mediaRouter from './routes/media.js';
import ontheflyRouter from './routes/onthefly.js';
import tiersRouter from './routes/tiers.js';
import adminRouter from './routes/admin.js';
import webhooksRouter from './routes/webhooks.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// Load environment variables
dotenv.config({ path: path.resolve(__dirname, '.env') });

// Connect to MongoDB
mongoose.connect(process.env.MONGO_URI)
  .then(() => console.log('✅ MongoDB connected'))
  .catch(err => console.error('❌ MongoDB error:', err.message));

const app = express();

// Security and performance middleware
app.use(helmet({
  contentSecurityPolicy: false,
  crossOriginEmbedderPolicy: false,
  strictTransportSecurity: { maxAge: 31536000, includeSubDomains: true }
}));
app.use(securityHeaders);
app.use(compression());
app.use(validateContentLength);
app.use(express.json({ limit: '10mb' }));
app.use(express.urlencoded({ extended: true, limit: '10mb' }));
app.use(sanitizeInput);

app.use(metricsMiddleware);
app.use(logMiddleware);

// --- SOCKET.IO REAL-TIME CHAT SETUP ---
const server = http.createServer(app);
const io = new Server(server, {
    cors: {
        origin: process.env.NODE_ENV === 'production' 
            ? ['https://meengle.app', 'https://www.meengle.app']
            : process.env.CORS_ORIGIN || '*',
        credentials: true,
        methods: ['GET', 'POST']
    },
    transports: ['websocket', 'polling']
});

// Online status tracking
const onlineUsers = new Map();
const userSockets = new Map();

// ════════════════════════════════════════════════════════════════
// SOCKET.IO EVENT HANDLERS
// ════════════════════════════════════════════════════════════════

io.on('connection', (socket) => {
    console.log(`[SOCKET] Connected: ${socket.id}`);

    // User comes online
    socket.on('user-online', (data) => {
        const { userId } = data;
        onlineUsers.set(userId, { socketId: socket.id, connectedAt: new Date() });
        userSockets.set(socket.id, userId);
        io.emit('user-status-changed', { userId, status: 'online' });
        analyzeUserBehavior(userId).catch(err => console.error('Behavior analysis error:', err));
    });

    // Chat: user joins conversation
    socket.on('join-chat', (data) => {
        const { userId, matchId } = data;
        const roomId = [userId, matchId].sort().join('-');
        socket.join(roomId);
        socket.to(roomId).emit('user-joined', { userId });
    });

    // Chat: send message
    socket.on('send-message', async (data) => {
        try {
            const { userId, matchId, message } = data;
            const roomId = [userId, matchId].sort().join('-');
            
            // Save to database
            const msg = new Message({
                senderId: userId,
                receiverId: matchId,
                message,
                timestamp: new Date(),
                read: false
            });
            await msg.save();
            
            // Broadcast
            io.to(roomId).emit('receive-message', {
                userId,
                message,
                timestamp: msg.timestamp,
                read: false
            });

            console.log(`[CHAT] ${userId} → ${matchId}: ${message}`);
        } catch (error) {
            console.error('Message error:', error);
            socket.emit('message-error', { error: 'Failed to send message' });
        }
    });

    // Typing indicator
    socket.on('typing', (data) => {
        const { userId, matchId } = data;
        const roomId = [userId, matchId].sort().join('-');
        socket.to(roomId).emit('user-typing', { userId });
    });

    socket.on('stop-typing', (data) => {
        const { userId, matchId } = data;
        const roomId = [userId, matchId].sort().join('-');
        socket.to(roomId).emit('user-stop-typing', { userId });
    });

    // Disconnect
    socket.on('disconnect', () => {
        const userId = userSockets.get(socket.id);
        if (userId) {
            onlineUsers.delete(userId);
            io.emit('user-status-changed', { userId, status: 'offline' });
            console.log(`[OFFLINE] ${userId}`);
        }
        userSockets.delete(socket.id);
    });
});

// ════════════════════════════════════════════════════════════════
// ROUTES
// ════════════════════════════════════════════════════════════════

app.use('/api/auth', authRouter);
app.use('/api/matches', matchingRouter);
app.use('/api/chat', chatRouter);
app.use('/api/payments', paymentsRouter);
app.use('/api/payment', paymentRouter);
app.use('/api/boosts', boostsRouter);
app.use('/api/verify', verifyRouter);
app.use('/api/prompts', promptsRouter);
app.use('/api/moments', momentsRouter);
app.use('/api/notes', notesRouter);
app.use('/api/circles', circlesRouter);
app.use('/api/stories', storiesRouter);
app.use('/api/dates', datesRouter);
app.use('/api/spotlight', spotlightRouter);
app.use('/api/roam', roamRouter);
app.use('/api/discovery', discoveryRouter);
app.use('/api/categories', categoriesRouter);
app.use('/api/messages', messagesRouter);
app.use('/api/locationchat', locationchatRouter);
app.use('/api/emergency', emergencyRouter);
app.use('/api/fraud', fraudRouter);
app.use('/api/notifications', notificationsRouter);
app.use('/api/media', mediaRouter);
app.use('/api/onthefly', ontheflyRouter);
app.use('/api/tiers', tiersRouter);
app.use('/api/admin', adminRouter);
app.use('/api/webhooks', webhooksRouter);

// ════════════════════════════════════════════════════════════════
// REST API ENDPOINTS
// ════════════════════════════════════════════════════════════════

// Health check
app.get('/health', async (req, res) => {
    const health = await healthCheck(io);
    res.json(health);
});

// Test endpoint
app.get('/api/test', (req, res) => {
    res.json({ 
        message: 'Backend is working!',
        timestamp: new Date().toISOString()
    });
});

// 404 handler
app.use((req, res) => {
    res.status(404).json({ error: 'Not found' });
});

app.use(errorLogger);
app.use(errorHandler);

// Schedule daily backup at midnight
scheduleAutoBackup(24);

const PORT = process.env.PORT || 3001;

const runningServer = server.listen(PORT, () => {
    console.log(`\n${'═'.repeat(60)}`);
    console.log('🚀 MEENGLE SERVER STARTED');
    console.log('═'.repeat(60));
    console.log(`📍 Port: ${PORT}`);
    console.log(`⏰ ${new Date().toISOString()}`);
    console.log('═'.repeat(60));
    console.log('\n✅ All systems ready\n');
});

// Graceful shutdown
process.on('SIGINT', () => {
    console.log('\nShutting down...');
    runningServer.close(() => process.exit(0));
});

export { app, server, io };
