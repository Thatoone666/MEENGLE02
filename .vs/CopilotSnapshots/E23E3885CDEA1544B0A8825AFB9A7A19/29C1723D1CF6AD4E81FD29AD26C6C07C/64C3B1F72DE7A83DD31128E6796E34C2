name: Android CI - Build Signed AAB

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build-aab:
    runs-on: ubuntu-latest
    env:
      JAVA_HOME: /usr/lib/jvm/adoptopenjdk-11-hotspot
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Install Java
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '11'

      - name: Set up Android SDK and build tools
        uses: reactivecircus/android-emulator-runner@v2
        with:
          api-level: 31
          target: default
          arch: x86_64
          force-avd-creation: false

      - name: Cache Gradle
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: ${{ runner.os }}-gradle-${{ hashFiles('**/gradle-wrapper.properties') }}
          restore-keys: |
            ${{ runner.os }}-gradle-

      - name: Install dependencies and build web
        run: |
          npm ci
          npm run build

      - name: Ensure Android platform exists and sync
        run: |
          if [ ! -d android ]; then
            npx cap add android
          fi
          npx cap sync android

      - name: Decode keystore
        run: |
          echo "$ANDROID_KEYSTORE" | base64 --decode > meengle-release-key.jks
          chmod 600 meengle-release-key.jks
        env:
          ANDROID_KEYSTORE: ${{ secrets.ANDROID_KEYSTORE }}

      - name: Build AAB (Gradle)
        working-directory: android
        run: |
          ./gradlew bundleRelease -Pandroid.injected.signing.store.file=../meengle-release-key.jks -Pandroid.injected.signing.store.password=${{ secrets.ANDROID_KEYSTORE_PASSWORD }} -Pandroid.injected.signing.key.alias=${{ secrets.ANDROID_KEY_ALIAS }} -Pandroid.injected.signing.key.password=${{ secrets.ANDROID_KEY_PASSWORD }}

      - name: Cleanup keystore
        if: always()
        run: |
          rm -f meengle-release-key.jks || true

      - name: Upload AAB artifact
        uses: actions/upload-artifact@v4
        with:
          name: meengle-aab
          path: android/app/build/outputs/bundle/release/app-release.aab

  debug-aab:
    runs-on: ubuntu-latest
    needs: build-aab
    steps:
      - uses: actions/checkout@v4
      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '18'
      - name: Install dependencies and build web
        run: |
          npm ci
          npm run build
      - name: Ensure Android platform exists and sync
        run: |
          if [ ! -d android ]; then
            npx cap add android
          fi
          npx cap sync android
      - name: Build unsigned debug AAB
        working-directory: android
        run: |
          ./gradlew bundleDebug
      - name: Upload unsigned debug AAB
        uses: actions/upload-artifact@v4
        with:
          name: meengle-debug-aab
          path: android/app/build/outputs/bundle/debug/app-debug.aab

  playstore-upload:
    name: Upload to Google Play (gated)
    runs-on: ubuntu-latest
    needs: build-aab
    if: ${{ secrets.GPLAY_SERVICE_ACCOUNT != '' }}
    steps:
      - uses: actions/checkout@v4
      - name: Download release AAB
        uses: actions/download-artifact@v4
        with:
          name: meengle-aab
          path: ./
      - name: Upload to Google Play
        uses: r0adkll/upload-google-play@v1
        with:
          serviceAccountJson: ${{ secrets.GPLAY_SERVICE_ACCOUNT }}
          packageName: com.meengle.app
          releaseFile: ./android/app/build/outputs/bundle/release/app-release.aab
          track: production
