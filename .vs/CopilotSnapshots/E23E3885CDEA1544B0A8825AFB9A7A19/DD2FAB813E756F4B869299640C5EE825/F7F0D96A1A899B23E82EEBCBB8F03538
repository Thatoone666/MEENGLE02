name: Build & Deploy to GitHub Pages

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'

      - name: Install frontend dependencies
        run: cd frontend && npm install

      - name: Build frontend assets
        run: cd frontend && npm run build

      - name: Prepare dist directory
        run: |
          mkdir -p dist
          mkdir -p dist/assets
          mkdir -p dist/src

      - name: Copy HTML pages to dist
        run: |
          cp frontend/index.html dist/ 2>/dev/null || true
          cp -r frontend/pages/* dist/ 2>/dev/null || true

      - name: Copy assets to dist
        run: |
          cp -r frontend/assets/* dist/assets/ 2>/dev/null || true

      - name: Copy source files to dist (for reference)
        run: |
          cp -r frontend/src dist/ 2>/dev/null || true

      - name: Create 404.html for SPA routing
        run: |
          if [ -f dist/pages/404.html ]; then
            cp dist/pages/404.html dist/404.html
          else
            cp dist/index.html dist/404.html
          fi

      - name: Deploy to GitHub Pages
        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
        uses: peaceiris/actions-gh-pages@v3
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: ./dist
          cname: false
          user_name: 'github-actions[bot]'
          user_email: 'github-actions[bot]@users.noreply.github.com'

      - name: Upload artifact for preview
        if: github.event_name == 'pull_request'
        uses: actions/upload-artifact@v3
        with:
          name: build-artifact
          path: dist/
