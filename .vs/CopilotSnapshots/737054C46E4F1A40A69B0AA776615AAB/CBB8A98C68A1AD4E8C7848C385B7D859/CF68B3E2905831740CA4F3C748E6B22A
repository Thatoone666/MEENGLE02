@echo off
REM Meengle Web App Build Script for Windows
REM This script builds the web app for deployment and APK generation

setlocal enabledelayedexpansion

echo ======================================
echo MEENGLE WEB APP BUILD SCRIPT
echo ======================================
echo.

REM Check if Node.js is installed
where node >nul 2>nul
if errorlevel 1 (
    echo [ERROR] Node.js is not installed. Please install it first.
    exit /b 1
)

echo Node.js version:
node --version
echo.

REM Check if npm is installed
where npm >nul 2>nul
if errorlevel 1 (
    echo [ERROR] npm is not installed. Please install it first.
    exit /b 1
)

echo npm version:
npm --version
echo.

REM Install frontend dependencies
echo [*] Installing frontend dependencies...
cd frontend
call npm install
if errorlevel 1 (
    echo [ERROR] Failed to install frontend dependencies
    exit /b 1
)
cd ..
echo [OK] Frontend dependencies installed
echo.

REM Build frontend assets
echo [*] Building frontend assets...
cd frontend
call npm run build
if errorlevel 1 (
    echo [ERROR] Frontend build failed
    exit /b 1
)
cd ..
echo [OK] Frontend assets built
echo.

REM Create dist directory structure
echo [*] Creating distribution structure...
if not exist "dist" mkdir dist
if not exist "dist\assets" mkdir dist\assets
if not exist "dist\assets\css" mkdir dist\assets\css
if not exist "dist\assets\js" mkdir dist\assets\js
if not exist "dist\assets\icons" mkdir dist\assets\icons
if not exist "dist\assets\images" mkdir dist\assets\images
if not exist "dist\pages" mkdir dist\pages

REM Copy HTML files
echo [*] Copying HTML files...
copy frontend\index.html dist\ >nul 2>&1
for %%f in (frontend\pages\*.html) do copy "%%f" dist\pages\ >nul 2>&1
copy frontend\manifest.json dist\ >nul 2>&1
copy frontend\service-worker.js dist\ >nul 2>&1

REM Verify required pages
echo [*] Verifying required pages...
set missing_pages=0
for %%p in (
    "login.html"
    "signup.html"
    "forgot-password.html"
    "landing.html"
    "dashboard.html"
    "terms.html"
    "privacy.html"
    "community-guidelines.html"
    "help.html"
    "safety.html"
    "error.html"
    "404.html"
    "verify-email.html"
    "profile.html"
    "settings.html"
    "subscription.html"
) do (
    if not exist "dist\pages\%%p" (
        echo [WARN] Missing page: %%p
        set /a missing_pages+=1
    )
)

if %missing_pages% gtr 0 (
    echo [WARN] %missing_pages% pages are missing but build will continue
) else (
    echo [OK] All required pages found
)
echo.

REM Copy assets
echo [*] Copying CSS files...
xcopy /E /I /Y frontend\assets\css\* dist\assets\css\ >nul 2>&1

echo [*] Copying JavaScript files...
xcopy /E /I /Y frontend\assets\js\* dist\assets\js\ >nul 2>&1

REM Copy images if they exist
if exist "frontend\assets\images" (
    echo [*] Copying images...
    xcopy /E /I /Y frontend\assets\images\* dist\assets\images\ >nul 2>&1
)

REM Copy icons if they exist
if exist "frontend\assets\icons" (
    echo [*] Copying icons...
    xcopy /E /I /Y frontend\assets\icons\* dist\assets\icons\ >nul 2>&1
)

echo [OK] Distribution files copied
echo.

REM Validate build
echo [*] Validating build...
set validation_passed=true

if not exist "dist\index.html" (
    echo [ERROR] dist\index.html not found
    set validation_passed=false
)

if not exist "dist\manifest.json" (
    echo [ERROR] dist\manifest.json not found
    set validation_passed=false
)

if not exist "dist\service-worker.js" (
    echo [ERROR] dist\service-worker.js not found
    set validation_passed=false
)

if not exist "dist\assets\js\*.*" (
    echo [ERROR] No JavaScript files in dist\assets\js
    set validation_passed=false
)

if "%validation_passed%"=="true" (
    echo [OK] Build validation passed
) else (
    echo [ERROR] Build validation failed
    exit /b 1
)

echo.
echo ======================================
echo [OK] BUILD COMPLETE
echo ======================================
echo.

echo Distribution folder: dist\
echo Ready for:
echo   - Web deployment (copy dist\ to server)
echo   - Capacitor/APK build (use dist as webDir)
echo   - Mobile app build
echo.

REM Count files
for /f %%A in ('dir /s /b dist 2^>nul ^| find /v /c ""') do set filecount=%%A
for /f %%A in ('dir /s /b dist\pages 2^>nul ^| find /v /c ""') do set pagecount=%%A

echo Build statistics:
echo   Total files: %filecount%
echo   HTML pages: %pagecount%
echo.

echo Next steps:
echo 1. For Capacitor APK build:
echo    npx cap sync
echo    npx cap build android
echo.
echo 2. For web deployment:
echo    Upload 'dist\' folder to your server
echo.
echo 3. For testing:
echo    npm install -g http-server
echo    http-server dist\
echo.
echo 4. For backend (if available):
echo    cd backend
echo    npm install
echo    npm start
echo.

echo BUILD READY! 🎉
pause
