## ?? USAGE EXAMPLES

### **Loading Screen**
```javascript
// Show loading
window.loadingScreen.show('Loading your profile...');

// Update message
window.loadingScreen.update('Almost ready...');

// Hide
window.loadingScreen.hide();
```

### **Real-Time Chat**
```javascript
// Connect
window.webSocketClient.connect(userId);

// Send message
window.webSocketClient.sendMessage(matchId, 'Hello!');

// Typing indicator
window.webSocketClient.sendTyping(matchId);

// Listen to messages
window.webSocketClient.on('message-received', (data) => {
  console.log('New message:', data);
});
```

### **Push Notifications**
```javascript
// Request permission
const granted = await window.fcmService.requestPermission();

// Get token
const token = await window.fcmService.getToken();

// Subscribe to topic
await window.fcmService.subscribe('matches');

// Send notification
window.fcmService.sendNotification('New Match!', {
  body: 'You have a new match',
  tag: 'match-notification'
});
```

### **Payment Processing**
```javascript
// Initialize
window.paymentService.init();

// Create payment element
window.paymentService.createPaymentElement('payment-element');

// Handle payment
const result = await window.paymentService.handlePayment(clientSecret);
if (result.success) {
  console.log('Payment successful!');
}
```

### **Image Upload**
```javascript
// Handle file selection
const results = await window.imageUploadManager.handleFileSelect(files);

// Upload to server
const uploadResults = await window.imageUploadManager.uploadMultiple(
  results,
  window.apiClient
);

// Get uploaded files
const uploaded = window.imageUploadManager.getUploadedFiles();
```

### **Geolocation**
```javascript
// Get current position
const location = await window.geolocationService.getCurrentPosition();

// Watch position (continuous)
window.geolocationService.watchPosition();

// Calculate distance
const distance = window.geolocationService.getDistance(lat, lon);

// Stop watching
window.geolocationService.stopWatching();
```

