# Example environment variables for the backend
# Copy this file to `.env` and fill in secrets before running the server.

# Node environment
NODE_ENV=development

# Server port
PORT=3000

# MongoDB connection string. Examples:
# - Local: mongodb://localhost:27017/meengle
# - Atlas SRV: mongodb+srv://<user>:<password>@cluster0.mongodb.net/meengle?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/meengle

# JWT secret used for signing tokens (replace with a secure secret)
JWT_SECRET=replace_with_a_secure_random_string

# Optional third-party keys
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=
STRIPE_SECRET=
GCS_BUCKET=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
MONGO_URI=mongodb://mongo:27017/meengle
JWT_SECRET=your_jwt_secret_key
PAYFAST_MERCHANT_ID=your_payfast_merchant_id
PAYFAST_MERCHANT_KEY=your_payfast_merchant_key
